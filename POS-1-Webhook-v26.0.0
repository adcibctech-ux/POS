/***************************************************************
 * SCRIPT: POS-1-Webhook-v26.0.0
 * SYSTEM: ADC|IBC POS Backend
 * TABLE(S): SYNC LOG
 *
 * PURPOSE:
 * Receives raw Square webhook payloads through an Airtable
 * webhook-triggered automation and creates a SYNC LOG record
 * for each webhook event received.
 *
 * VERSIONING:
 * POS-1-Webhook-v26.0.0
 *
 * Version format:
 * - First digit: major POS workflow/script number.
 * - Second digit: major structural version.
 * - Third digit: revision number.
 *
 * For this script family, POS-1 remains constant.
 * Increment the third digit for each revision:
 * - POS-1-Webhook-v26.0.0 = first iteration
 * - POS-1-Webhook-v26.0.1 = first revision
 * - POS-1-Webhook-v26.0.2 = second revision
 *
 * SCRIPT BEHAVIOR:
 * 1. Reads the incoming Square webhook payload from the Airtable
 *    automation input variable named `payload`.
 * 2. Extracts the Square Event ID from the webhook payload.
 * 3. Extracts the Square Event Type from the webhook payload.
 * 4. Extracts the Square Object ID when available.
 * 5. Stores the full raw webhook payload in SYNC LOG for debugging.
 * 6. Creates a new SYNC LOG record when the Square Event ID has
 *    not been previously logged.
 * 7. Checks for duplicate Square Event IDs before creating the
 *    main webhook log record.
 * 8. If a duplicate event is received, creates a duplicate log
 *    record linked back to the original SYNC LOG record.
 * 9. Sets Processing Status to Received, Duplicate, or Failed
 *    depending on webhook processing outcome.
 * 10. Outputs basic processing results back to the automation run.
 *
 * BUG FIXES / REVISION NOTES:
 * v26.0.0
 * - Initial POS webhook intake script.
 * - Added Square Event ID extraction.
 * - Added Square Event Type extraction.
 * - Added Square Object ID extraction.
 * - Added duplicate event detection using Square Event ID.
 * - Added duplicate SYNC LOG creation instead of reprocessing.
 * - Added raw webhook payload storage.
 * - Added failed-payload handling when Square Event ID is missing.
 *
 * REQUIRED AIRTABLE AUTOMATION INPUTS:
 * - payload: Full webhook body from the Airtable webhook trigger.
 *
 * REQUIRED TABLES:
 * - SYNC LOG
 *
 * REQUIRED SYNC LOG FIELDS:
 * - Square Event ID
 * - Processing Status
 * - Event Type
 * - Square Object ID
 * - Raw Webhook Payload
 * - Error Message
 * - Automation Step
 * - Duplicate Of
 * - Resolved?
 ***************************************************************/

const config = input.config();
const payload = config.payload;

const SYNC_LOG_TABLE = "SYNC LOG";

// Field names in SYNC LOG
const FIELD_SQUARE_EVENT_ID = "Square Event ID";
const FIELD_PROCESSING_STATUS = "Processing Status";
const FIELD_EVENT_TYPE = "Event Type";
const FIELD_SQUARE_OBJECT_ID = "Square Object ID";
const FIELD_RAW_WEBHOOK_PAYLOAD = "Raw Webhook Payload";
const FIELD_ERROR_MESSAGE = "Error Message";
const FIELD_AUTOMATION_STEP = "Automation Step";
const FIELD_DUPLICATE_OF = "Duplicate Of";
const FIELD_RESOLVED = "Resolved?";

const STATUS_RECEIVED = "Received";
const STATUS_DUPLICATE = "Duplicate";
const STATUS_FAILED = "Failed";

const STEP_WEBHOOK_RECEIVED = "Webhook Received";
const STEP_DUPLICATE = "Duplicate";
const STEP_FAILED = "Failed";

const EVENT_TYPE_UNKNOWN = "unknown";

const syncLogTable = base.getTable(SYNC_LOG_TABLE);

function stringifySafe(value) {
    try {
        return JSON.stringify(value, null, 2);
    } catch (error) {
        return String(value);
    }
}

function getSquareEventId(squarePayload) {
    return (
        squarePayload?.event_id ||
        squarePayload?.eventId ||
        squarePayload?.id ||
        null
    );
}

function getSquareEventType(squarePayload) {
    return (
        squarePayload?.type ||
        squarePayload?.event_type ||
        squarePayload?.eventType ||
        EVENT_TYPE_UNKNOWN
    );
}

function getSquareObjectId(squarePayload) {
    return (
        squarePayload?.data?.id ||
        squarePayload?.data?.object?.id ||
        squarePayload?.data?.object?.payment?.id ||
        squarePayload?.data?.object?.order?.id ||
        squarePayload?.data?.object?.refund?.id ||
        null
    );
}

try {
    if (!payload) {
        throw new Error("No webhook payload was received by the script input variable named payload.");
    }

    const squareEventId = getSquareEventId(payload);
    const eventType = getSquareEventType(payload);
    const squareObjectId = getSquareObjectId(payload);
    const rawPayloadText = stringifySafe(payload);

    if (!squareEventId) {
        await syncLogTable.createRecordAsync({
            [FIELD_SQUARE_EVENT_ID]: `MISSING_EVENT_ID_${Date.now()}`,
            [FIELD_PROCESSING_STATUS]: { name: STATUS_FAILED },
            [FIELD_EVENT_TYPE]: { name: EVENT_TYPE_UNKNOWN },
            [FIELD_SQUARE_OBJECT_ID]: squareObjectId || "",
            [FIELD_RAW_WEBHOOK_PAYLOAD]: rawPayloadText,
            [FIELD_ERROR_MESSAGE]: "Webhook payload did not include a Square Event ID.",
            [FIELD_AUTOMATION_STEP]: { name: STEP_FAILED },
            [FIELD_RESOLVED]: false
        });

        throw new Error("Webhook payload did not include a Square Event ID.");
    }

    // Check for duplicate Square Event ID
    const existingRecords = await syncLogTable.selectRecordsAsync({
        fields: [FIELD_SQUARE_EVENT_ID]
    });

    const existingMatch = existingRecords.records.find(record => {
        return record.getCellValueAsString(FIELD_SQUARE_EVENT_ID) === squareEventId;
    });

    if (existingMatch) {
        await syncLogTable.createRecordAsync({
            [FIELD_SQUARE_EVENT_ID]: `${squareEventId}_DUPLICATE_${Date.now()}`,
            [FIELD_PROCESSING_STATUS]: { name: STATUS_DUPLICATE },
            [FIELD_EVENT_TYPE]: { name: eventType },
            [FIELD_SQUARE_OBJECT_ID]: squareObjectId || "",
            [FIELD_RAW_WEBHOOK_PAYLOAD]: rawPayloadText,
            [FIELD_ERROR_MESSAGE]: `Duplicate webhook event. Original SYNC LOG record: ${existingMatch.id}`,
            [FIELD_AUTOMATION_STEP]: { name: STEP_DUPLICATE },
            [FIELD_DUPLICATE_OF]: [{ id: existingMatch.id }],
            [FIELD_RESOLVED]: true
        });

        output.set("result", "duplicate");
        output.set("squareEventId", squareEventId);
        output.set("duplicateOf", existingMatch.id);
        return;
    }

    const newSyncLogId = await syncLogTable.createRecordAsync({
        [FIELD_SQUARE_EVENT_ID]: squareEventId,
        [FIELD_PROCESSING_STATUS]: { name: STATUS_RECEIVED },
        [FIELD_EVENT_TYPE]: { name: eventType },
        [FIELD_SQUARE_OBJECT_ID]: squareObjectId || "",
        [FIELD_RAW_WEBHOOK_PAYLOAD]: rawPayloadText,
        [FIELD_AUTOMATION_STEP]: { name: STEP_WEBHOOK_RECEIVED },
        [FIELD_RESOLVED]: false
    });

    output.set("result", "created");
    output.set("syncLogRecordId", newSyncLogId);
    output.set("squareEventId", squareEventId);
    output.set("eventType", eventType);
    output.set("squareObjectId", squareObjectId || "");

} catch (error) {
    output.set("result", "failed");
    output.set("error", error.message);
    throw error;
}
