/***************************************************************
 * SCRIPT: POS-1-Webhook-v26.1.1
 * SYSTEM: ADC|IBC POS Backend
 * TABLE(S): SYNC LOG
 *
 * PURPOSE:
 * Receives raw Square webhook payloads through an Airtable
 * webhook-triggered automation and creates a processor-agnostic
 * SYNC LOG record for each webhook event received.
 *
 * VERSIONING:
 * POS-1-Webhook-v26.1.1
 *
 * Version format:
 * - POS-1 = major POS workflow/script number.
 * - v26 = 2026 system standard.
 * - .1 = architectural/structural revision.
 * - .1 = first bugfix revision of this architecture.
 *
 * SCRIPT BEHAVIOR:
 * 1. Reads the incoming webhook payload from the Airtable automation
 *    input variable named `payload`.
 * 2. Detects whether Airtable passed the event directly or wrapped it
 *    inside `payload.body`.
 * 3. Parses JSON-string bodies when needed.
 * 4. Extracts the processor event ID.
 * 5. Extracts the webhook event type.
 * 6. Extracts the processor object ID when available.
 * 7. Maps the event type to a processor object type.
 * 8. Writes Payment Processor as Square.
 * 9. Stores the full raw Airtable webhook payload in SYNC LOG.
 * 10. Checks for duplicate Processor Event IDs before creating the
 *     main webhook log record.
 * 11. If a duplicate event is received, creates a duplicate log record
 *     linked back to the original SYNC LOG record.
 * 12. Sets Processing Status to Received, Duplicate, or Failed.
 * 13. Sets Automation Step to Webhook Received, Duplicate, or Failed.
 * 14. Outputs processing results back to the automation run.
 *
 * BUG FIXES / REVISION NOTES:
 * v26.1.1
 * - Removed all writes to Received At because Received At is an
 *   Airtable Created time field and cannot be modified by script.
 *
 * v26.1.0
 * - Updated script for processor-agnostic SYNC LOG field names.
 * - Replaced Square Event ID with Processor Event ID.
 * - Replaced Square Object ID with Processor Object ID.
 * - Replaced Raw Webhook Payload with Raw Event Payload.
 * - Added Payment Processor = Square.
 * - Added Processor Object Type mapping.
 * - Preserved duplicate detection by processor event ID.
 * - Preserved Airtable webhook wrapper/body parsing from v26.0.1.
 *
 * REQUIRED AIRTABLE AUTOMATION INPUTS:
 * - payload: Full JSON data object from the Airtable webhook trigger.
 *
 * REQUIRED TABLES:
 * - SYNC LOG
 *
 * REQUIRED SYNC LOG FIELDS:
 * - Processor Event ID
 * - Payment Processor
 * - Processing Status
 * - Event Type
 * - Processor Object Type
 * - Processor Object ID
 * - Received At
 * - Related Transaction
 * - Raw Event Payload
 * - Raw API Response
 * - Error Message
 * - Retry Count
 * - Last Retry At
 * - Resolved?
 * - Resolved Notes
 * - Duplicate Of
 * - Automation Step
 ***************************************************************/

const config = input.config();
const payload = config.payload;

const SYNC_LOG_TABLE = "SYNC LOG";

// SYNC LOG field names
const FIELD_PROCESSOR_EVENT_ID = "Processor Event ID";
const FIELD_PAYMENT_PROCESSOR = "Payment Processor";
const FIELD_PROCESSING_STATUS = "Processing Status";
const FIELD_EVENT_TYPE = "Event Type";
const FIELD_PROCESSOR_OBJECT_TYPE = "Processor Object Type";
const FIELD_PROCESSOR_OBJECT_ID = "Processor Object ID";
const FIELD_RAW_EVENT_PAYLOAD = "Raw Event Payload";
const FIELD_ERROR_MESSAGE = "Error Message";
const FIELD_DUPLICATE_OF = "Duplicate Of";
const FIELD_AUTOMATION_STEP = "Automation Step";
const FIELD_RESOLVED = "Resolved?";
const FIELD_RESOLVED_NOTES = "Resolved Notes";

// Select values
const PAYMENT_PROCESSOR_SQUARE = "Square";

const STATUS_RECEIVED = "Received";
const STATUS_DUPLICATE = "Duplicate";
const STATUS_FAILED = "Failed";

const STEP_WEBHOOK_RECEIVED = "Webhook Received";
const STEP_DUPLICATE = "Duplicate";
const STEP_FAILED = "Failed";

const OBJECT_TYPE_PAYMENT = "Payment";
const OBJECT_TYPE_ORDER = "Order";
const OBJECT_TYPE_REFUND = "Refund";
const OBJECT_TYPE_CATALOG = "Catalog";
const OBJECT_TYPE_INVENTORY = "Inventory";
const OBJECT_TYPE_CUSTOMER = "Customer";
const OBJECT_TYPE_UNKNOWN = "Unknown";

const EVENT_TYPE_UNKNOWN = "unknown";

const syncLogTable = base.getTable(SYNC_LOG_TABLE);

function stringifySafe(value) {
    try {
        return JSON.stringify(value, null, 2);
    } catch (error) {
        return String(value);
    }
}

function parseIfJsonString(value) {
    if (typeof value !== "string") {
        return value;
    }

    try {
        return JSON.parse(value);
    } catch (error) {
        return value;
    }
}

function normalizeWebhookPayload(rawPayload) {
    /*
     * Airtable webhook trigger can pass:
     * 1. The actual Square event directly:
     *    payload.event_id
     *
     * 2. The full Airtable wrapper:
     *    payload.body.event_id
     *
     * 3. The body as a JSON string:
     *    payload.body = '{"event_id":"..."}'
     */

    if (!rawPayload) {
        return null;
    }

    const parsedPayload = parseIfJsonString(rawPayload);

    if (parsedPayload?.body) {
        return parseIfJsonString(parsedPayload.body);
    }

    return parsedPayload;
}

function getProcessorEventId(eventPayload) {
    return (
        eventPayload?.event_id ||
        eventPayload?.eventId ||
        eventPayload?.id ||
        null
    );
}

function getEventType(eventPayload) {
    return (
        eventPayload?.type ||
        eventPayload?.event_type ||
        eventPayload?.eventType ||
        EVENT_TYPE_UNKNOWN
    );
}

function getProcessorObjectId(eventPayload) {
    return (
        eventPayload?.data?.id ||
        eventPayload?.data?.object?.id ||
        eventPayload?.data?.object?.payment?.id ||
        eventPayload?.data?.object?.order?.id ||
        eventPayload?.data?.object?.refund?.id ||
        eventPayload?.data?.object?.catalog_object?.id ||
        eventPayload?.data?.object?.inventory_counts?.[0]?.catalog_object_id ||
        eventPayload?.data?.object?.customer?.id ||
        null
    );
}

function getProcessorObjectType(eventType) {
    if (!eventType) {
        return OBJECT_TYPE_UNKNOWN;
    }

    if (eventType.startsWith("payment.")) {
        return OBJECT_TYPE_PAYMENT;
    }

    if (eventType.startsWith("order.")) {
        return OBJECT_TYPE_ORDER;
    }

    if (eventType.startsWith("refund.")) {
        return OBJECT_TYPE_REFUND;
    }

    if (eventType.startsWith("catalog.")) {
        return OBJECT_TYPE_CATALOG;
    }

    if (eventType.startsWith("inventory.")) {
        return OBJECT_TYPE_INVENTORY;
    }

    if (eventType.startsWith("customer.")) {
        return OBJECT_TYPE_CUSTOMER;
    }

    return OBJECT_TYPE_UNKNOWN;
}

async function findExistingEventRecord(processorEventId) {
    const existingRecords = await syncLogTable.selectRecordsAsync({
        fields: [FIELD_PROCESSOR_EVENT_ID]
    });

    return existingRecords.records.find(record => {
        return record.getCellValueAsString(FIELD_PROCESSOR_EVENT_ID) === processorEventId;
    }) || null;
}

async function createFailedLogRecord({
    processorObjectId,
    eventType,
    objectType,
    rawPayloadText,
    errorMessage
}) {
    return await syncLogTable.createRecordAsync({
        [FIELD_PROCESSOR_EVENT_ID]: `MISSING_EVENT_ID_${Date.now()}`,
        [FIELD_PAYMENT_PROCESSOR]: { name: PAYMENT_PROCESSOR_SQUARE },
        [FIELD_PROCESSING_STATUS]: { name: STATUS_FAILED },
        [FIELD_EVENT_TYPE]: { name: eventType || EVENT_TYPE_UNKNOWN },
        [FIELD_PROCESSOR_OBJECT_TYPE]: { name: objectType || OBJECT_TYPE_UNKNOWN },
        [FIELD_PROCESSOR_OBJECT_ID]: processorObjectId || "",
        [FIELD_RAW_EVENT_PAYLOAD]: rawPayloadText,
        [FIELD_ERROR_MESSAGE]: errorMessage,
        [FIELD_AUTOMATION_STEP]: { name: STEP_FAILED },
        [FIELD_RESOLVED]: false
    });
}

try {
    if (!payload) {
        throw new Error("No webhook payload was received by the script input variable named payload.");
    }

    const eventPayload = normalizeWebhookPayload(payload);

    if (!eventPayload) {
        throw new Error("Webhook payload could not be normalized.");
    }

    const processorEventId = getProcessorEventId(eventPayload);
    const eventType = getEventType(eventPayload);
    const processorObjectId = getProcessorObjectId(eventPayload);
    const processorObjectType = getProcessorObjectType(eventType);
    const rawPayloadText = stringifySafe(payload);

    if (!processorEventId) {
        const errorMessage = "Webhook payload did not include a processor event ID after checking payload and payload.body.";

        await createFailedLogRecord({
            processorObjectId,
            eventType,
            objectType: processorObjectType,
            rawPayloadText,
            errorMessage
        });

        throw new Error(errorMessage);
    }

    const existingMatch = await findExistingEventRecord(processorEventId);

    if (existingMatch) {
        const duplicateRecordId = await syncLogTable.createRecordAsync({
            [FIELD_PROCESSOR_EVENT_ID]: `${processorEventId}_DUPLICATE_${Date.now()}`,
            [FIELD_PAYMENT_PROCESSOR]: { name: PAYMENT_PROCESSOR_SQUARE },
            [FIELD_PROCESSING_STATUS]: { name: STATUS_DUPLICATE },
            [FIELD_EVENT_TYPE]: { name: eventType },
            [FIELD_PROCESSOR_OBJECT_TYPE]: { name: processorObjectType },
            [FIELD_PROCESSOR_OBJECT_ID]: processorObjectId || "",
            [FIELD_RAW_EVENT_PAYLOAD]: rawPayloadText,
            [FIELD_ERROR_MESSAGE]: `Duplicate webhook event. Original SYNC LOG record: ${existingMatch.id}`,
            [FIELD_AUTOMATION_STEP]: { name: STEP_DUPLICATE },
            [FIELD_DUPLICATE_OF]: [{ id: existingMatch.id }],
            [FIELD_RESOLVED]: true,
            [FIELD_RESOLVED_NOTES]: "Duplicate processor event ID received. Original event already logged."
        });

        output.set("result", "duplicate");
        output.set("syncLogRecordId", duplicateRecordId);
        output.set("processorEventId", processorEventId);
        output.set("duplicateOf", existingMatch.id);
        output.set("eventType", eventType);
        output.set("processorObjectType", processorObjectType);
        output.set("processorObjectId", processorObjectId || "");
        return;
    }

    const newSyncLogId = await syncLogTable.createRecordAsync({
        [FIELD_PROCESSOR_EVENT_ID]: processorEventId,
        [FIELD_PAYMENT_PROCESSOR]: { name: PAYMENT_PROCESSOR_SQUARE },
        [FIELD_PROCESSING_STATUS]: { name: STATUS_RECEIVED },
        [FIELD_EVENT_TYPE]: { name: eventType },
        [FIELD_PROCESSOR_OBJECT_TYPE]: { name: processorObjectType },
        [FIELD_PROCESSOR_OBJECT_ID]: processorObjectId || "",
        [FIELD_RAW_EVENT_PAYLOAD]: rawPayloadText,
        [FIELD_AUTOMATION_STEP]: { name: STEP_WEBHOOK_RECEIVED },
        [FIELD_RESOLVED]: false
    });

    output.set("result", "created");
    output.set("syncLogRecordId", newSyncLogId);
    output.set("processorEventId", processorEventId);
    output.set("paymentProcessor", PAYMENT_PROCESSOR_SQUARE);
    output.set("eventType", eventType);
    output.set("processorObjectType", processorObjectType);
    output.set("processorObjectId", processorObjectId || "");

} catch (error) {
    output.set("result", "failed");
    output.set("error", error.message);
    throw error;
}
