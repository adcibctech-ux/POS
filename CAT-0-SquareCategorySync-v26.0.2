/***************************************************************
 * SCRIPT: CAT-0-SquareCategorySync-v26.0.2
 * SYSTEM: ADC|IBC POS Backend
 * TABLE(S): PROCESSOR CATEGORY MAP, ITEM LIBRARY
 *
 * PURPOSE:
 * Creates or updates one Square PRODUCTION catalog category from one
 * Airtable PROCESSOR CATEGORY MAP record, including Square category
 * hierarchy for sub-categories.
 *
 * VERSIONING:
 * CAT-0-SquareCategorySync-v26.0.2
 *
 * Version format:
 * - CAT-0 = category sync workflow/script number.
 * - v26 = 2026 system standard.
 * - .0 = first CAT-0 logic release branch.
 * - .2 = idempotency key bug-fix iteration.
 *
 * SCRIPT BEHAVIOR:
 * 1. Runs from an Airtable automation triggered when one category-map
 *    record enters the Ready for Category Sync view.
 * 2. Reads only the triggering PROCESSOR CATEGORY MAP record for sync.
 * 3. Confirms:
 *    - Catalog Processor = SQUARE
 *    - Processor Environment = PRODUCTION
 *    - Sync to Processor? = checked
 *    - Sync Status = READY TO SYNC
 * 4. If Airtable Category Type = PARENT CATEGORY:
 *    - creates/updates a top-level Square CATEGORY.
 * 5. If Airtable Category Type = SUB-CATEGORY:
 *    - infers parent category from ITEM LIBRARY using:
 *        ITEM LIBRARY Sub-Category → ITEM LIBRARY Parent Category
 *    - finds the matching synced parent record in PROCESSOR CATEGORY MAP.
 *    - creates/updates the Square CATEGORY with category_data.parent_category.id.
 * 6. If Processor Category ID is blank:
 *    - creates a new Square CATEGORY object.
 * 7. If Processor Category ID exists:
 *    - updates the existing Square CATEGORY object.
 * 8. On success:
 *    - writes Processor Category ID
 *    - writes Processor Category Version
 *    - sets Sync Status = SYNCED
 *    - sets Last Sync At = now
 *    - clears Sync Error
 *    - saves Raw Sync Response
 * 9. On failure:
 *    - sets Sync Status = SYNC ERROR
 *    - writes Sync Error
 *    - saves Raw Sync Response if available
 *
 * BUG FIXES / REVISION NOTES:
 * v26.0.2
 * - Fixed Square IDEMPOTENCY_KEY_REUSED errors on category creation.
 * - Category create idempotency key now includes Date.now() so retried
 *   category creates with changed payloads are accepted.
 *
 * v26.0.1
 * - Added Square category hierarchy support for sub-categories.
 * - Sub-categories now attach to their synced parent Square category using category_data.parent_category.id.
 * - Parent category is inferred from ITEM LIBRARY Parent Category/Sub-Category relationships.
 *
 * v26.0.0
 * - Initial production Square category sync release.
 *
 * IMPORTANT:
 * - Processor Category Name may be a formula field.
 * - This script reads Processor Category Name but does not write to it.
 * - If Processor Category Name is blank, it falls back to Airtable Category Name.
 * - Parent categories must be synced before their sub-categories.
 *
 * REQUIRED AIRTABLE AUTOMATION INPUTS:
 * - categoryMapRecordId
 *
 * REQUIRED AIRTABLE SECRET:
 * - SQUARE_PRODUCTION_ACCESS_TOKEN
 ***************************************************************/

const config = input.config();
const categoryMapRecordId = config.categoryMapRecordId;

const SQUARE_VERSION = "2026-05-20";
const SQUARE_BASE_URL = "https://connect.squareup.com";
const SQUARE_ACCESS_TOKEN = input.secret("SQUARE_PRODUCTION_ACCESS_TOKEN");

const CATEGORY_MAP_TABLE_ID = "tblQeN0UiqavIxdZQ";
const ITEM_LIBRARY_TABLE_ID = "tblLRCNq7FWidVntW";

// PROCESSOR CATEGORY MAP fields
const CAT_CATEGORY_MAP_ID = "Category Map ID";
const CAT_CATALOG_PROCESSOR = "Catalog Processor";
const CAT_PROCESSOR_ENVIRONMENT = "Processor Environment";
const CAT_AIRTABLE_CATEGORY_TYPE = "Airtable Category Type";
const CAT_AIRTABLE_CATEGORY_NAME = "Airtable Category Name";
const CAT_PROCESSOR_CATEGORY_ID = "Processor Category ID";
const CAT_PROCESSOR_CATEGORY_NAME = "Processor Category Name";
const CAT_PROCESSOR_CATEGORY_VERSION = "Processor Category Version";
const CAT_SYNC_TO_PROCESSOR = "Sync to Processor?";
const CAT_SYNC_STATUS = "Sync Status";
const CAT_LAST_SYNC_AT = "Last Sync At";
const CAT_SYNC_ERROR = "Sync Error";
const CAT_RAW_SYNC_RESPONSE = "Raw Sync Response";
const CAT_NOTES = "Notes";

// ITEM LIBRARY fields
const ITEM_PARENT_CATEGORY = "Parent Category";
const ITEM_SUB_CATEGORY = "Sub-Category";

// All-caps Airtable select option values
const PROCESSOR_SQUARE = "SQUARE";
const ENVIRONMENT_PRODUCTION = "PRODUCTION";
const TYPE_PARENT_CATEGORY = "PARENT CATEGORY";
const TYPE_SUB_CATEGORY = "SUB-CATEGORY";
const STATUS_READY_TO_SYNC = "READY TO SYNC";
const STATUS_SYNCED = "SYNCED";
const STATUS_SYNC_ERROR = "SYNC ERROR";

const categoryMapTable = base.getTable(CATEGORY_MAP_TABLE_ID);
const itemLibraryTable = base.getTable(ITEM_LIBRARY_TABLE_ID);

function selectValue(name) {
    return { name };
}

function getSelectName(record, fieldName) {
    return record.getCellValue(fieldName)?.name || "";
}

function normalizeText(value) {
    if (value === null || value === undefined) {
        return "";
    }

    return String(value).trim();
}

function normalizeKey(value) {
    return normalizeText(value).toLowerCase();
}

function makeTempCategoryId(categoryName, recordId) {
    const safeName = normalizeText(categoryName)
        .toUpperCase()
        .replace(/[^A-Z0-9]+/g, "-")
        .replace(/^-+|-+$/g, "")
        .slice(0, 60);

    return `#CATEGORY-${safeName || recordId}`;
}

function safeStringify(value) {
    try {
        return JSON.stringify(value, null, 2);
    } catch (error) {
        return String(value);
    }
}

function getNumberVersion(value) {
    const numeric = Number(normalizeText(value));
    return Number.isFinite(numeric) && numeric > 0 ? numeric : null;
}

function getIdFromMappings(idMappings, clientObjectId) {
    const mapping = (idMappings || []).find(item => item.client_object_id === clientObjectId);
    return mapping?.object_id || null;
}

async function squareRequest(path, method, body) {
    const response = await fetch(`${SQUARE_BASE_URL}${path}`, {
        method,
        headers: {
            "Square-Version": SQUARE_VERSION,
            "Authorization": `Bearer ${SQUARE_ACCESS_TOKEN}`,
            "Content-Type": "application/json"
        },
        body: body ? JSON.stringify(body) : undefined
    });

    const text = await response.text();
    let json;

    try {
        json = text ? JSON.parse(text) : {};
    } catch (error) {
        json = { rawText: text };
    }

    if (!response.ok) {
        const errorMessage = json?.errors
            ? json.errors.map(err => `${err.code || "ERROR"}: ${err.detail || err.field || ""}`).join(" | ")
            : `Square request failed with status ${response.status}`;

        const error = new Error(errorMessage);
        error.squareResponse = json;
        error.status = response.status;
        throw error;
    }

    return json;
}

async function markSyncError(recordId, error, rawResponse = null) {
    const errorText = error?.message || String(error);
    const responseToSave = rawResponse || error?.squareResponse || { error: errorText };

    await categoryMapTable.updateRecordAsync(recordId, {
        [CAT_SYNC_STATUS]: selectValue(STATUS_SYNC_ERROR),
        [CAT_SYNC_ERROR]: errorText,
        [CAT_RAW_SYNC_RESPONSE]: safeStringify(responseToSave)
    });

    output.set("result", "sync_error");
    output.set("error", errorText);
}

async function getCategoryMapRecords() {
    const query = await categoryMapTable.selectRecordsAsync({
        fields: [
            CAT_CATEGORY_MAP_ID,
            CAT_CATALOG_PROCESSOR,
            CAT_PROCESSOR_ENVIRONMENT,
            CAT_AIRTABLE_CATEGORY_TYPE,
            CAT_AIRTABLE_CATEGORY_NAME,
            CAT_PROCESSOR_CATEGORY_ID,
            CAT_PROCESSOR_CATEGORY_NAME,
            CAT_PROCESSOR_CATEGORY_VERSION,
            CAT_SYNC_TO_PROCESSOR,
            CAT_SYNC_STATUS,
            CAT_LAST_SYNC_AT,
            CAT_SYNC_ERROR,
            CAT_RAW_SYNC_RESPONSE,
            CAT_NOTES
        ]
    });

    return query;
}

async function getItemLibraryRecords() {
    const query = await itemLibraryTable.selectRecordsAsync({
        fields: [
            ITEM_PARENT_CATEGORY,
            ITEM_SUB_CATEGORY
        ]
    });

    return query;
}

function validateRecordForProductionSync(categoryRecord) {
    const processor = getSelectName(categoryRecord, CAT_CATALOG_PROCESSOR);
    const environment = getSelectName(categoryRecord, CAT_PROCESSOR_ENVIRONMENT);
    const syncStatus = getSelectName(categoryRecord, CAT_SYNC_STATUS);
    const syncToProcessor = categoryRecord.getCellValue(CAT_SYNC_TO_PROCESSOR) === true;

    if (processor !== PROCESSOR_SQUARE) {
        throw new Error(`Catalog Processor must be ${PROCESSOR_SQUARE}; found "${processor || "blank"}".`);
    }

    if (environment !== ENVIRONMENT_PRODUCTION) {
        throw new Error(`Processor Environment must be ${ENVIRONMENT_PRODUCTION}; found "${environment || "blank"}".`);
    }

    if (!syncToProcessor) {
        throw new Error("Sync to Processor? must be checked.");
    }

    if (syncStatus !== STATUS_READY_TO_SYNC) {
        throw new Error(`Sync Status must be ${STATUS_READY_TO_SYNC}; found "${syncStatus || "blank"}".`);
    }
}

function buildCategoryPayload(categoryRecord) {
    const processorCategoryName = normalizeText(categoryRecord.getCellValueAsString(CAT_PROCESSOR_CATEGORY_NAME));
    const airtableCategoryName = normalizeText(categoryRecord.getCellValueAsString(CAT_AIRTABLE_CATEGORY_NAME));
    const airtableCategoryType = getSelectName(categoryRecord, CAT_AIRTABLE_CATEGORY_TYPE);

    const categoryName = processorCategoryName || airtableCategoryName;

    if (!airtableCategoryType) {
        throw new Error("Airtable Category Type is required.");
    }

    if (!airtableCategoryName) {
        throw new Error("Airtable Category Name is required.");
    }

    if (!categoryName) {
        throw new Error("Processor Category Name formula is blank and Airtable Category Name is also blank.");
    }

    if (![TYPE_PARENT_CATEGORY, TYPE_SUB_CATEGORY].includes(airtableCategoryType)) {
        throw new Error(`Airtable Category Type must be ${TYPE_PARENT_CATEGORY} or ${TYPE_SUB_CATEGORY}; found "${airtableCategoryType}".`);
    }

    return {
        categoryName,
        airtableCategoryName,
        airtableCategoryType
    };
}

function inferParentCategoryNameForSubcategory(subcategoryName, itemQuery) {
    const matchingParentNames = new Set();

    for (const itemRecord of itemQuery.records) {
        const itemSubcategoryName = getSelectName(itemRecord, ITEM_SUB_CATEGORY);
        const itemParentCategoryName = getSelectName(itemRecord, ITEM_PARENT_CATEGORY);

        if (normalizeKey(itemSubcategoryName) === normalizeKey(subcategoryName) && itemParentCategoryName) {
            matchingParentNames.add(itemParentCategoryName);
        }
    }

    const parentNames = Array.from(matchingParentNames);

    if (parentNames.length === 0) {
        throw new Error(`Could not infer a parent category for sub-category "${subcategoryName}" from ITEM LIBRARY.`);
    }

    if (parentNames.length > 1) {
        throw new Error(`Sub-category "${subcategoryName}" is used under multiple parent categories in ITEM LIBRARY: ${parentNames.join(", ")}.`);
    }

    return parentNames[0];
}

function findSyncedParentCategoryMapRecord(parentCategoryName, categoryQuery) {
    const matches = categoryQuery.records.filter(record => {
        const processor = getSelectName(record, CAT_CATALOG_PROCESSOR);
        const environment = getSelectName(record, CAT_PROCESSOR_ENVIRONMENT);
        const categoryType = getSelectName(record, CAT_AIRTABLE_CATEGORY_TYPE);
        const categoryName = normalizeText(record.getCellValueAsString(CAT_AIRTABLE_CATEGORY_NAME));
        const processorCategoryId = normalizeText(record.getCellValueAsString(CAT_PROCESSOR_CATEGORY_ID));

        return (
            processor === PROCESSOR_SQUARE &&
            environment === ENVIRONMENT_PRODUCTION &&
            categoryType === TYPE_PARENT_CATEGORY &&
            normalizeKey(categoryName) === normalizeKey(parentCategoryName) &&
            processorCategoryId
        );
    });

    if (matches.length === 0) {
        throw new Error(`Parent category "${parentCategoryName}" must be synced before this sub-category. No matching parent PROCESSOR CATEGORY MAP record with Processor Category ID was found.`);
    }

    if (matches.length > 1) {
        throw new Error(`Multiple synced parent category map records found for "${parentCategoryName}".`);
    }

    return matches[0];
}

function resolveParentCategoryReference(payload, categoryQuery, itemQuery) {
    if (payload.airtableCategoryType === TYPE_PARENT_CATEGORY) {
        return {
            parentCategoryName: "",
            parentCategoryId: ""
        };
    }

    const parentCategoryName = inferParentCategoryNameForSubcategory(payload.airtableCategoryName, itemQuery);
    const parentCategoryRecord = findSyncedParentCategoryMapRecord(parentCategoryName, categoryQuery);
    const parentCategoryId = normalizeText(parentCategoryRecord.getCellValueAsString(CAT_PROCESSOR_CATEGORY_ID));

    return {
        parentCategoryName,
        parentCategoryId
    };
}

function buildSquareCategoryData(payload, parentReference) {
    const categoryData = {
        name: payload.categoryName
    };

    if (parentReference.parentCategoryId) {
        categoryData.parent_category = {
            id: parentReference.parentCategoryId
        };
    }

    return categoryData;
}

async function createSquareCategory(categoryRecord, payload, parentReference) {
    const tempCategoryId = makeTempCategoryId(payload.categoryName, categoryRecord.id);

    const requestBody = {
        idempotency_key: `cat0-prod-create-${categoryRecord.id}-${Date.now()}`,
        object: {
            id: tempCategoryId,
            type: "CATEGORY",
            present_at_all_locations: true,
            category_data: buildSquareCategoryData(payload, parentReference)
        }
    };

    const response = await squareRequest("/v2/catalog/object", "POST", requestBody);

    const categoryId = response.catalog_object?.id ||
        getIdFromMappings(response.id_mappings, tempCategoryId);

    const version = response.catalog_object?.version;

    if (!categoryId) {
        throw new Error("Square category create succeeded but returned missing category ID.");
    }

    return {
        response,
        categoryId,
        version
    };
}

async function updateSquareCategory(categoryRecord, payload, parentReference) {
    const categoryId = normalizeText(categoryRecord.getCellValueAsString(CAT_PROCESSOR_CATEGORY_ID));
    const existingVersion = getNumberVersion(categoryRecord.getCellValueAsString(CAT_PROCESSOR_CATEGORY_VERSION));

    if (!categoryId) {
        throw new Error("Cannot update because Processor Category ID is blank.");
    }

    const object = {
        id: categoryId,
        type: "CATEGORY",
        present_at_all_locations: true,
        category_data: buildSquareCategoryData(payload, parentReference)
    };

    if (existingVersion) {
        object.version = existingVersion;
    }

    const requestBody = {
        idempotency_key: `cat0-prod-update-${categoryRecord.id}-${Date.now()}`,
        object
    };

    const response = await squareRequest("/v2/catalog/object", "POST", requestBody);
    const returnedObject = response.catalog_object || {};

    return {
        response,
        categoryId: returnedObject.id || categoryId,
        version: returnedObject.version
    };
}

async function markSynced(recordId, syncResult, parentReference) {
    const rawResponseWithParentContext = {
        parentCategoryName: parentReference.parentCategoryName || null,
        parentCategoryId: parentReference.parentCategoryId || null,
        squareResponse: syncResult.response
    };

    await categoryMapTable.updateRecordAsync(recordId, {
        [CAT_PROCESSOR_CATEGORY_ID]: syncResult.categoryId,
        [CAT_PROCESSOR_CATEGORY_VERSION]: syncResult.version ? String(syncResult.version) : "",
        [CAT_SYNC_STATUS]: selectValue(STATUS_SYNCED),
        [CAT_LAST_SYNC_AT]: new Date().toISOString(),
        [CAT_SYNC_ERROR]: "",
        [CAT_RAW_SYNC_RESPONSE]: safeStringify(rawResponseWithParentContext)
    });

    output.set("result", "synced");
    output.set("processorCategoryId", syncResult.categoryId);
    output.set("processorCategoryVersion", syncResult.version ? String(syncResult.version) : "");
    output.set("parentCategoryId", parentReference.parentCategoryId || "");
    output.set("parentCategoryName", parentReference.parentCategoryName || "");
}

async function main() {
    if (!categoryMapRecordId) {
        throw new Error("Missing required input variable: categoryMapRecordId.");
    }

    const categoryQuery = await getCategoryMapRecords();
    const itemQuery = await getItemLibraryRecords();
    const categoryRecord = categoryQuery.getRecord(categoryMapRecordId);

    if (!categoryRecord) {
        throw new Error(`Could not find category map record: ${categoryMapRecordId}`);
    }

    try {
        validateRecordForProductionSync(categoryRecord);

        const payload = buildCategoryPayload(categoryRecord);
        const parentReference = resolveParentCategoryReference(payload, categoryQuery, itemQuery);
        const existingCategoryId = normalizeText(categoryRecord.getCellValueAsString(CAT_PROCESSOR_CATEGORY_ID));

        const syncResult = existingCategoryId
            ? await updateSquareCategory(categoryRecord, payload, parentReference)
            : await createSquareCategory(categoryRecord, payload, parentReference);

        await markSynced(categoryRecord.id, syncResult, parentReference);
    } catch (error) {
        await markSyncError(categoryRecord.id, error);
    }
}

await main();
