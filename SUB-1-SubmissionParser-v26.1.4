////////////////////////////////////////////////////////////////////////////////
// SUB-1-SubmissionParser-v26.1.4
// POS Backend | INVENTORY SUBMISSIONS → DRAFT ITEMS
//
// PURPOSE
// Parses one raw INVENTORY SUBMISSIONS record into normalized DRAFT ITEMS rows.
// This script does NOT create ITEM LIBRARY records, PROCESSOR CATALOG MAP records,
// or INVENTORY MOVEMENTS.
//
// REQUIRED AUTOMATION INPUT
//   submissionRecordId
//
// RECOMMENDED TRIGGER
//   When INVENTORY SUBMISSIONS record enters parsing-ready view:
//   - Parser Status = Not Parsed or blank
//   - Submission Status = Draft / submitted state
//   - Product Type is populated
//
// SAFETY BEHAVIOR
//   - Deletes old linked draft items ONLY when Draft Status is blank or "Draft".
//   - Preserves old draft items that have moved into review/approval/processed states.
//   - Creates one DRAFT ITEMS row per positive quantity field.
//   - Negative/decimal quantities create parser errors and block parsing.
//   - New/unapproved PRODUCT TYPES create warnings in DRAFT ITEMS.
//   - Missing/unsynced processor category maps create warnings.
//
// UPDATES / BUG FIXES
//   v26.1.4
//   - Updated missing image warning flags.
//
//   v26.1.3
//   - Updated quantity parsing for new 3-letter size field codes.
//   - Reads INVENTORY SUBMISSIONS quantity fields such as BLK ONE Qty,
//     BLK YSM Qty, BLK AXS Qty, etc.
//   - Generates SKUs using 3-letter size codes.
//   - Writes DRAFT ITEMS {Size} using admin-facing labels:
//     OS, YXS, YS, YM, YL, YXL, XS, SM, MD, LG, XL, 2X.
//   - Removed 3X from parser size handling.
//   - Updated NOC parsing from {NOC OS Qty} to {NOC ONE Qty}.
//   - Keeps product images optional and does not warn when image fields are blank.
//
//   v26.1.2
//   - Removed warning flag when no images are uploaded in submission.
//
//   v26.1.1
//   - Schema alignment patch for finalized PRODUCT TYPES linked-field naming.
//   - Updated INVENTORY SUBMISSIONS product type source field from {PRODUCT TYPES}
//     to {Product Type}, assuming {Product Type} is now the linked record field.
//   - Updated DRAFT ITEMS product type destination field from {PRODUCT TYPES}
//     to {Product Type}.
//   - Removed direct writes to DRAFT ITEMS {Parent Category} and {Subcategory}
//     because those fields are now lookup fields derived from linked {Product Type}.
//   - Removed direct writes to DRAFT ITEMS {Processor Category Map} because the
//     staging table no longer needs a writable processor category map field.
//   - Parser still validates the linked PRODUCT TYPES record, including Product Type
//     Status, Product Type Code, Parent Category, Subcategory, and category sync state.
//   - Parser now relies on Airtable lookups in DRAFT ITEMS to display parent category
//     and subcategory context after the linked Product Type is written.
//   - No changes to safe regeneration behavior for existing Draft-status draft items.
//
//   v26.1.0
//   - Major revision: PRODUCT TYPES linked records are now the source of truth.
//   - Ignores legacy INVENTORY SUBMISSIONS {Product Type} single select entirely.
//   - Ignores legacy DRAFT ITEMS {Product Type} single select entirely.
//   - Reads Product Type Name, Product Type Code, Parent Category, Subcategory,
//     and Product Type Status from linked PRODUCT TYPES record.
//   - Writes linked DRAFT ITEMS {Product Type} instead of old Product Type select.
//   - Flags PRODUCT TYPES records that are not Approved.
//   - Uses PRODUCT TYPES linked category records to determine parent/subcategory
//     text and processor category map linkage.
//   - Supports Passes with Parent Category = Passes and no Subcategory.
//   - Keeps NOC/OS pass behavior from earlier versions.
//
//   v26.0.1
//   - Added support for INVENTORY SUBMISSIONS {New Product Type}.
//   - Superseded by v26.1.0 linked PRODUCT TYPES architecture.
//
//   v26.0.0
//   - Initial submission parser.
//   - Parsed BLK/WHT/GRY/COL quantity buckets and NOC OS Qty.
//   - Generated DRAFT ITEMS records from INVENTORY SUBMISSIONS.
//
////////////////////////////////////////////////////////////////////////////////

const CONFIG = input.config();
const submissionRecordId = (CONFIG.submissionRecordId || "").trim();

if (!submissionRecordId) {
    throw new Error("Missing required input variable: submissionRecordId");
}

////////////////////////////////////////////////////////////////////////////////
// TABLES
////////////////////////////////////////////////////////////////////////////////

const submissionsTable = base.getTable("INVENTORY SUBMISSIONS");
const draftItemsTable = base.getTable("DRAFT ITEMS");
const productTypesTable = base.getTable("PRODUCT TYPES");
const categoryMapTable = base.getTable("PROCESSOR CATEGORY MAP");
const designsTable = base.getTable("DESIGNS");

////////////////////////////////////////////////////////////////////////////////
// FIELD NAMES
////////////////////////////////////////////////////////////////////////////////

const SUB = {
    submissionId: "Submission ID",
    status: "Submission Status",
    design: "Design",
    productTypes: "Product Type",
    unitPrice: "Unit Price",
    unitCost: "Unit Cost",
    productionLocation: "Production Location",
    parserStatus: "Parser Status",
    parserNotes: "Parser Notes",
    itemDrafts: "Item Drafts",
};

const DRAFT = {
    draftSku: "Draft SKU",
    draftStatus: "Draft Status",
    inventorySubmission: "Inventory Submission",
    design: "Design",
    productTypes: "Product Type",
    colorFamily: "Color Family",
    size: "Size",
    itemName: "Item Name",
    variantName: "Variant Name",
    barcodeValue: "Barcode Value",
    unitPrice: "Unit Price",
    unitCost: "Unit Cost",
    startingProductionQuantity: "Starting Production Quantity",
    productionLocation: "Production Location",
    productImage: "Product Image",
    imageGroupKey: "Image Group Key",
    validationStatus: "Validation Status",
    validationNotes: "Validation Notes",
    processingStatus: "Processing Status",
};

const PRODUCT = {
    name: "Product Type Name",
    code: "Product Type Code",
    parentCategory: "Parent Category",
    subcategory: "Subcategory",
    status: "Product Type Status",
};

const CATMAP = {
    categoryType: "Airtable Category Type",
    categoryName: "Airtable Category Name",
    processorCategoryId: "Processor Category ID",
    syncStatus: "Sync Status",
    catalogProcessor: "Catalog Processor",
    processorEnvironment: "Processor Environment",
};

const DESIGN = {
    name: "Design Name",
    code: "Design Code",
};

////////////////////////////////////////////////////////////////////////////////
// CONSTANTS
////////////////////////////////////////////////////////////////////////////////

const COLOR_BUCKETS = [
    { code: "BLK", imageField: "BLK Image" },
    { code: "WHT", imageField: "WHT Image" },
    { code: "GRY", imageField: "GRY Image" },
    { code: "COL", imageField: "COL Image" },
];

const SIZE_CONFIGS = [
    { fieldCode: "ONE", skuCode: "ONE", sizeLabel: "OS" },
    { fieldCode: "YXS", skuCode: "YXS", sizeLabel: "YXS" },
    { fieldCode: "YSM", skuCode: "YSM", sizeLabel: "YS" },
    { fieldCode: "YMD", skuCode: "YMD", sizeLabel: "YM" },
    { fieldCode: "YLG", skuCode: "YLG", sizeLabel: "YL" },
    { fieldCode: "YXL", skuCode: "YXL", sizeLabel: "YXL" },
    { fieldCode: "AXS", skuCode: "AXS", sizeLabel: "XS" },
    { fieldCode: "ASM", skuCode: "ASM", sizeLabel: "SM" },
    { fieldCode: "AMD", skuCode: "AMD", sizeLabel: "MD" },
    { fieldCode: "ALG", skuCode: "ALG", sizeLabel: "LG" },
    { fieldCode: "AXL", skuCode: "AXL", sizeLabel: "XL" },
    { fieldCode: "A2X", skuCode: "A2X", sizeLabel: "2X" },
];

const NOC_BUCKET = {
    code: "NOC",
    fieldCode: "ONE",
    skuCode: "ONE",
    sizeLabel: "OS",
    qtyField: "NOC ONE Qty",
};

const DRAFT_DELETE_STATUSES = new Set(["", "Draft"]);

////////////////////////////////////////////////////////////////////////////////
// HELPERS
////////////////////////////////////////////////////////////////////////////////

function getSingleSelectName(record, fieldName) {
    const value = record.getCellValue(fieldName);
    return value?.name || "";
}

function getLinkedRecordIds(record, fieldName) {
    const value = record.getCellValue(fieldName);
    if (!Array.isArray(value)) return [];
    return value.map((linked) => linked.id);
}

function getNumber(record, fieldName) {
    const value = record.getCellValue(fieldName);
    if (value === null || value === undefined || value === "") return null;
    return Number(value);
}

function getText(record, fieldName) {
    return String(record.getCellValueAsString(fieldName) || "").trim();
}

function attachmentPayload(record, fieldName) {
    const value = record.getCellValue(fieldName);
    if (!Array.isArray(value) || value.length === 0) return [];

    return value
        .filter((attachment) => attachment.url)
        .map((attachment) => ({
            url: attachment.url,
            filename: attachment.filename || attachment.name || "attachment",
        }));
}

function chunkArray(array, size) {
    const chunks = [];

    for (let i = 0; i < array.length; i += size) {
        chunks.push(array.slice(i, i + size));
    }

    return chunks;
}

function normalizeCode(value) {
    return String(value || "")
        .toUpperCase()
        .replace(/&/g, "AND")
        .replace(/[^A-Z0-9]+/g, "-")
        .replace(/^-+|-+$/g, "")
        .replace(/-+/g, "-");
}

function makeSku({ designCode, productCode, colorCode, sizeCode }) {
    const parts = [designCode, productCode, colorCode, sizeCode]
        .map(normalizeCode)
        .filter(Boolean);

    return parts.join("-");
}

function buildItemName({ designName, productTypeName }) {
    return [designName, productTypeName].filter(Boolean).join(" ");
}

function buildVariantName({ colorCode, sizeLabel }) {
    if (colorCode === "NOC" && sizeLabel === "OS") return "One Size";
    return `${colorCode} / ${sizeLabel}`;
}

function formatNotes(notes) {
    return notes.length ? notes.join("\n") : "";
}

function isWholeNumber(value) {
    return Number.isInteger(value);
}

function categoryMapLabel(categoryRecord) {
    if (!categoryRecord) return "Unknown Category";

    const categoryType = getSingleSelectName(categoryRecord, CATMAP.categoryType);
    const categoryName = getText(categoryRecord, CATMAP.categoryName);

    return `${categoryType || "Unknown Type"}: ${categoryName || "Unknown Name"}`;
}

function validateQuantity(record, fieldName, errors) {
    const quantity = getNumber(record, fieldName);

    if (quantity === null || quantity === 0) return null;

    if (!Number.isFinite(quantity)) {
        errors.push(`${fieldName}: quantity is not a valid number.`);
        return null;
    }

    if (quantity < 0) {
        errors.push(`${fieldName}: quantity cannot be negative.`);
        return null;
    }

    if (!isWholeNumber(quantity)) {
        errors.push(`${fieldName}: quantity must be a whole number.`);
        return null;
    }

    return quantity;
}

function positiveQuantityEntriesForBucket(record, bucket, errors) {
    const entries = [];

    for (const sizeConfig of SIZE_CONFIGS) {
        const fieldName = `${bucket.code} ${sizeConfig.fieldCode} Qty`;
        const quantity = validateQuantity(record, fieldName, errors);

        if (quantity === null) continue;

        entries.push({
            colorCode: bucket.code,
            fieldCode: sizeConfig.fieldCode,
            skuSizeCode: sizeConfig.skuCode,
            sizeLabel: sizeConfig.sizeLabel,
            quantity,
            imageField: bucket.imageField,
        });
    }

    return entries;
}

function positiveNocEntry(record, errors) {
    const quantity = validateQuantity(record, NOC_BUCKET.qtyField, errors);

    if (quantity === null) return null;

    return {
        colorCode: NOC_BUCKET.code,
        fieldCode: NOC_BUCKET.fieldCode,
        skuSizeCode: NOC_BUCKET.skuCode,
        sizeLabel: NOC_BUCKET.sizeLabel,
        quantity,
        imageField: null,
    };
}

////////////////////////////////////////////////////////////////////////////////
// LOAD SUBMISSION
////////////////////////////////////////////////////////////////////////////////

const submission = await submissionsTable.selectRecordAsync(submissionRecordId);

if (!submission) {
    throw new Error(`Could not find INVENTORY SUBMISSIONS record: ${submissionRecordId}`);
}

const submissionName = getText(submission, SUB.submissionId) || submission.id;
const designIds = getLinkedRecordIds(submission, SUB.design);
const productTypeIds = getLinkedRecordIds(submission, SUB.productTypes);
const productionLocationIds = getLinkedRecordIds(submission, SUB.productionLocation);
const unitPrice = submission.getCellValue(SUB.unitPrice);
const unitCost = submission.getCellValue(SUB.unitCost);

const warnings = [];
const errors = [];

////////////////////////////////////////////////////////////////////////////////
// VALIDATE LINKED PRODUCT TYPE
////////////////////////////////////////////////////////////////////////////////

if (productTypeIds.length !== 1) {
    errors.push(`Product Type must contain exactly one linked product type. Found ${productTypeIds.length}.`);
}

let productTypeRecord = null;
let productTypeName = "";
let productTypeCode = "";
let productTypeStatus = "";
let productParentCategoryIds = [];
let productSubcategoryIds = [];

if (productTypeIds.length === 1) {
    productTypeRecord = await productTypesTable.selectRecordAsync(productTypeIds[0]);

    if (!productTypeRecord) {
        errors.push(`Linked PRODUCT TYPES record could not be loaded: ${productTypeIds[0]}`);
    } else {
        productTypeName = getText(productTypeRecord, PRODUCT.name);
        productTypeCode = getText(productTypeRecord, PRODUCT.code);
        productTypeStatus = getSingleSelectName(productTypeRecord, PRODUCT.status);
        productParentCategoryIds = getLinkedRecordIds(productTypeRecord, PRODUCT.parentCategory);
        productSubcategoryIds = getLinkedRecordIds(productTypeRecord, PRODUCT.subcategory);

        if (!productTypeName) {
            errors.push("Linked PRODUCT TYPES record is missing Product Type Name.");
        }

        if (!productTypeCode) {
            errors.push("Linked PRODUCT TYPES record is missing Product Type Code.");
        }

        if (!productTypeStatus) {
            warnings.push("Linked PRODUCT TYPES record is missing Product Type Status.");
        } else if (productTypeStatus !== "Approved") {
            warnings.push(`Product Type "${productTypeName || productTypeRecord.name}" is not Approved. Current status: ${productTypeStatus}.`);
        }

        if (productParentCategoryIds.length !== 1) {
            errors.push(`PRODUCT TYPES {Parent Category} must contain exactly one linked category map. Found ${productParentCategoryIds.length}.`);
        }

        if (productSubcategoryIds.length > 1) {
            errors.push(`PRODUCT TYPES {Subcategory} may contain zero or one linked category map. Found ${productSubcategoryIds.length}.`);
        }
    }
}

////////////////////////////////////////////////////////////////////////////////
// LOAD PRODUCT TYPE CATEGORY MAPS
////////////////////////////////////////////////////////////////////////////////

let parentCategoryRecord = null;
let subcategoryRecord = null;

if (productParentCategoryIds.length === 1) {
    parentCategoryRecord = await categoryMapTable.selectRecordAsync(productParentCategoryIds[0]);

    if (!parentCategoryRecord) {
        errors.push(`Linked Parent Category map could not be loaded: ${productParentCategoryIds[0]}`);
    }
}

if (productSubcategoryIds.length === 1) {
    subcategoryRecord = await categoryMapTable.selectRecordAsync(productSubcategoryIds[0]);

    if (!subcategoryRecord) {
        errors.push(`Linked Subcategory map could not be loaded: ${productSubcategoryIds[0]}`);
    }
}

let parentCategoryName = "";
let subcategoryName = "";
let parentCategoryType = "";
let subcategoryType = "";

if (parentCategoryRecord) {
    parentCategoryType = getSingleSelectName(parentCategoryRecord, CATMAP.categoryType);
    parentCategoryName = getText(parentCategoryRecord, CATMAP.categoryName);

    if (parentCategoryType !== "Parent Category") {
        warnings.push(`Linked PRODUCT TYPES Parent Category is not marked as Airtable Category Type = Parent Category. Found: ${parentCategoryType || "blank"}.`);
    }

    if (!parentCategoryName) {
        errors.push("Linked Parent Category map is missing Airtable Category Name.");
    }
}

if (subcategoryRecord) {
    subcategoryType = getSingleSelectName(subcategoryRecord, CATMAP.categoryType);
    subcategoryName = getText(subcategoryRecord, CATMAP.categoryName);

    if (subcategoryType !== "Subcategory") {
        warnings.push(`Linked PRODUCT TYPES Subcategory is not marked as Airtable Category Type = Subcategory. Found: ${subcategoryType || "blank"}.`);
    }

    if (!subcategoryName) {
        errors.push("Linked Subcategory map is missing Airtable Category Name.");
    }
}

const isPass = parentCategoryName === "Passes" && productSubcategoryIds.length === 0;
const requiresDesign = !isPass;

if (!isPass && productSubcategoryIds.length !== 1) {
    errors.push("Non-pass product types must have exactly one linked Subcategory.");
}

////////////////////////////////////////////////////////////////////////////////
// VALIDATE SUBMISSION BASICS
////////////////////////////////////////////////////////////////////////////////

if (productionLocationIds.length !== 1) {
    errors.push(`Production Location must contain exactly one linked location. Found ${productionLocationIds.length}.`);
}

if (requiresDesign && designIds.length !== 1) {
    errors.push(`Design must contain exactly one linked design for non-pass inventory. Found ${designIds.length}.`);
}

if (!requiresDesign && designIds.length > 1) {
    errors.push(`Pass submissions may have zero or one linked Design. Found ${designIds.length}.`);
}

if (unitPrice === null || unitPrice === undefined) {
    warnings.push("Unit Price is blank.");
}

if (unitCost === null || unitCost === undefined) {
    warnings.push("Unit Cost is blank.");
}

////////////////////////////////////////////////////////////////////////////////
// VALIDATE PROCESSOR CATEGORY MAP SYNC STATUS
////////////////////////////////////////////////////////////////////////////////

const processorCategoryRecord = isPass ? parentCategoryRecord : subcategoryRecord;

if (!processorCategoryRecord) {
    warnings.push("Processor category map could not be linked because no matching parent/subcategory record was resolved.");
} else {
    const categoryLabel = categoryMapLabel(processorCategoryRecord);
    const processorCategoryId = getText(processorCategoryRecord, CATMAP.processorCategoryId);
    const syncStatus = getSingleSelectName(processorCategoryRecord, CATMAP.syncStatus);
    const catalogProcessor = getSingleSelectName(processorCategoryRecord, CATMAP.catalogProcessor);
    const processorEnvironment = getSingleSelectName(processorCategoryRecord, CATMAP.processorEnvironment);

    if (catalogProcessor && catalogProcessor !== "SQUARE") {
        warnings.push(`${categoryLabel} has Catalog Processor = ${catalogProcessor}, expected SQUARE.`);
    }

    if (processorEnvironment && processorEnvironment !== "PRODUCTION") {
        warnings.push(`${categoryLabel} has Processor Environment = ${processorEnvironment}, expected PRODUCTION.`);
    }

    if (!processorCategoryId || syncStatus !== "SYNCED") {
        warnings.push(`${categoryLabel} is not fully synced. Sync Status: ${syncStatus || "blank"}.`);
    }
}

////////////////////////////////////////////////////////////////////////////////
// BUILD QUANTITY ENTRIES
////////////////////////////////////////////////////////////////////////////////

const entries = [];

for (const bucket of COLOR_BUCKETS) {
    entries.push(...positiveQuantityEntriesForBucket(submission, bucket, errors));
}

const nocEntry = positiveNocEntry(submission, errors);

if (nocEntry) {
    entries.push(nocEntry);
}

if (entries.length === 0) {
    errors.push("No positive quantity fields were found to parse.");
}

if (!isPass) {
    const invalidNoc = entries.find((entry) => entry.colorCode === "NOC");

    if (invalidNoc) {
        warnings.push("NOC ONE Qty is present on a non-pass submission. This will still parse, but should be reviewed.");
    }
}

if (isPass) {
    const nonNocEntries = entries.filter((entry) => entry.colorCode !== "NOC");

    if (nonNocEntries.length > 0) {
        warnings.push("Pass submission includes BLK/WHT/GRY/COL quantities. These will parse, but should be reviewed.");
    }
}

////////////////////////////////////////////////////////////////////////////////
// STOP ON BLOCKING ERRORS
////////////////////////////////////////////////////////////////////////////////

if (errors.length > 0) {
    await submissionsTable.updateRecordAsync(submission.id, {
        [SUB.parserStatus]: { name: "Failed" },
        [SUB.status]: { name: "Needs Changes" },
        [SUB.parserNotes]: formatNotes([
            `SUB-1 v26.1.3 failed for ${submissionName}.`,
            "",
            "Errors:",
            ...errors.map((error) => `- ${error}`),
            "",
            ...(warnings.length ? ["Warnings:", ...warnings.map((warning) => `- ${warning}`)] : []),
        ]),
    });

    throw new Error(`SUB-1 v26.1.3 failed for ${submissionName}: ${errors.join(" | ")}`);
}

////////////////////////////////////////////////////////////////////////////////
// DELETE OLD DRAFT ITEMS THAT ARE SAFE TO REGENERATE
////////////////////////////////////////////////////////////////////////////////

const existingDraftIds = getLinkedRecordIds(submission, SUB.itemDrafts);

let deletedCount = 0;
let preservedCount = 0;

if (existingDraftIds.length > 0) {
    const draftQuery = await draftItemsTable.selectRecordsAsync({
        fields: [DRAFT.draftStatus],
    });

    const recordsToDelete = [];

    for (const draftId of existingDraftIds) {
        const draftRecord = draftQuery.getRecord(draftId);

        if (!draftRecord) continue;

        const draftStatus = getSingleSelectName(draftRecord, DRAFT.draftStatus);

        if (DRAFT_DELETE_STATUSES.has(draftStatus)) {
            recordsToDelete.push(draftRecord.id);
        } else {
            preservedCount += 1;
        }
    }

    for (const batch of chunkArray(recordsToDelete, 50)) {
        await draftItemsTable.deleteRecordsAsync(batch);
        deletedCount += batch.length;
    }

    if (preservedCount > 0) {
        warnings.push(`${preservedCount} linked draft item(s) were preserved because they were no longer blank/Draft.`);
    }
}

////////////////////////////////////////////////////////////////////////////////
// RESOLVE DESIGN INFO
////////////////////////////////////////////////////////////////////////////////

const designId = designIds[0] || null;
const productTypeId = productTypeIds[0];
const productionLocationId = productionLocationIds[0];

let designName = "";
let designCode = "";

if (designId) {
    const designRecord = await designsTable.selectRecordAsync(designId);

    if (designRecord) {
        designName = getText(designRecord, DESIGN.name);
        designCode = getText(designRecord, DESIGN.code);
    }
}

if (!designName && isPass) {
    designName = "Pass";
}

if (!designCode && isPass) {
    designCode = productTypeCode;
}

if (!designName) {
    warnings.push("Design Name could not be resolved from linked Design.");
}

if (!designCode) {
    warnings.push("Design Code could not be resolved from linked Design.");
}

////////////////////////////////////////////////////////////////////////////////
// CREATE DRAFT ITEMS
////////////////////////////////////////////////////////////////////////////////

const createPayloads = [];
const seenSkus = new Set();

for (const entry of entries) {
    const draftSku = makeSku({
        designCode,
        productCode: productTypeCode,
        colorCode: entry.colorCode,
        sizeCode: entry.skuSizeCode,
    });

    if (!draftSku) {
        warnings.push(`Skipped a row because Draft SKU could not be generated for ${entry.colorCode} ${entry.sizeLabel}.`);
        continue;
    }

    if (seenSkus.has(draftSku)) {
        warnings.push(`Duplicate Draft SKU generated within this parse: ${draftSku}. Skipping duplicate.`);
        continue;
    }

    seenSkus.add(draftSku);

    const itemName = buildItemName({
        designName,
        productTypeName,
    });

    const variantName = buildVariantName({
        colorCode: entry.colorCode,
        sizeLabel: entry.sizeLabel,
    });

    const imageAttachments = entry.imageField ? attachmentPayload(submission, entry.imageField) : [];

    const itemWarnings = [];

    if (productTypeStatus !== "Approved") {
        itemWarnings.push(`Product Type is not Approved. Current status: ${productTypeStatus || "blank"}.`);
    }

    if (!processorCategoryRecord) {
        itemWarnings.push("Processor category map was not resolved.");
    } else {
        const processorCategoryId = getText(processorCategoryRecord, CATMAP.processorCategoryId);
        const syncStatus = getSingleSelectName(processorCategoryRecord, CATMAP.syncStatus);

        if (!processorCategoryId || syncStatus !== "SYNCED") {
            itemWarnings.push(`Processor category map is not fully synced. Sync Status: ${syncStatus || "blank"}.`);
        }
    }

    // Product images are optional.
    // Do not warn when image fields are blank.

    const validationStatus = itemWarnings.length > 0 ? "Warning" : "Valid";
    
    createPayloads.push({
        fields: {
            [DRAFT.draftSku]: draftSku,
            [DRAFT.draftStatus]: { name: "Draft" },
            [DRAFT.inventorySubmission]: [{ id: submission.id }],
            ...(designId ? { [DRAFT.design]: [{ id: designId }] } : {}),
            [DRAFT.productTypes]: [{ id: productTypeId }],
            [DRAFT.colorFamily]: { name: entry.colorCode },
            [DRAFT.size]: { name: entry.sizeLabel },
            [DRAFT.itemName]: itemName,
            [DRAFT.variantName]: variantName,
            [DRAFT.barcodeValue]: draftSku,
            ...(unitPrice !== null && unitPrice !== undefined ? { [DRAFT.unitPrice]: unitPrice } : {}),
            ...(unitCost !== null && unitCost !== undefined ? { [DRAFT.unitCost]: unitCost } : {}),
            [DRAFT.startingProductionQuantity]: entry.quantity,
            [DRAFT.productionLocation]: [{ id: productionLocationId }],
            ...(imageAttachments.length > 0 ? { [DRAFT.productImage]: imageAttachments } : {}),
            [DRAFT.imageGroupKey]: `${designCode || "NO-DESIGN"}-${productTypeCode}-${entry.colorCode}`,
            [DRAFT.validationStatus]: { name: validationStatus },
            [DRAFT.validationNotes]: formatNotes(itemWarnings),
            [DRAFT.processingStatus]: { name: "Not Processed" },
        },
    });
}

let createdCount = 0;

for (const batch of chunkArray(createPayloads, 50)) {
    await draftItemsTable.createRecordsAsync(batch);
    createdCount += batch.length;
}

////////////////////////////////////////////////////////////////////////////////
// FINAL SUBMISSION UPDATE
////////////////////////////////////////////////////////////////////////////////

const finalParserStatus = warnings.length > 0 ? "Needs Review" : "Parsed";
const finalSubmissionStatus = warnings.length > 0 ? "Ready for Aud Review" : "Parsed to Draft Items";

await submissionsTable.updateRecordAsync(submission.id, {
    [SUB.parserStatus]: { name: finalParserStatus },
    [SUB.status]: { name: finalSubmissionStatus },
    [SUB.parserNotes]: formatNotes([
        `SUB-1 v26.1.3 completed for ${submissionName}.`,
        `Created draft items: ${createdCount}`,
        `Deleted old draft items: ${deletedCount}`,
        `Preserved old draft items: ${preservedCount}`,
        "",
        "Product Type:",
        `- Name: ${productTypeName}`,
        `- Code: ${productTypeCode}`,
        `- Status: ${productTypeStatus || "blank"}`,
        "",
        "Category Resolution:",
        `- Parent Category: ${parentCategoryName || "blank"}`,
        `- Subcategory: ${subcategoryName || "N/A"}`,
        `- Processor Category Map: ${processorCategoryRecord ? categoryMapLabel(processorCategoryRecord) : "blank"}`,
        "",
        ...(warnings.length ? ["Warnings:", ...warnings.map((warning) => `- ${warning}`)] : ["No warnings."]),
    ]),
});

output.set("submissionRecordId", submission.id);
