function isSquareProductionSyncCandidate(record) {
    return (
        getSelectName(record, PCM_CATALOG_PROCESSOR) === PROCESSOR_SQUARE &&
        getSelectName(record, PCM_PROCESSOR_ENVIRONMENT) === ENVIRONMENT_PRODUCTION &&
        record.getCellValue(PCM_SYNC_TO_PROCESSOR) === true
    );
}

function isReadyToSync(record) {
    return (
        isSquareProductionSyncCandidate(record) &&
        getSelectName(record, PCM_SYNC_STATUS) === STATUS_READY_TO_SYNC
    );
}

function isSynced(record) {
    return (
        isSquareProductionSyncCandidate(record) &&
        getSelectName(record, PCM_SYNC_STATUS) === STATUS_SYNCED
    );
}

function getLinkedItemRecord(catalogRecord, itemQuery) {
    const itemIds = getLinkedRecordIds(catalogRecord, PCM_ITEM);

    if (itemIds.length !== 1) {
        return {
            status: "needs_review",
            message: `PROCESSOR CATALOG MAP record must have exactly one linked Item. Found ${itemIds.length}.`
        };
    }

    const itemRecord = itemQuery.getRecord(itemIds[0]);

    if (!itemRecord) {
        return {
            status: "needs_review",
            message: `Linked ITEM LIBRARY record could not be found: ${itemIds[0]}`
        };
    }

    return {
        status: "ok",
        itemRecord
    };
}

function getLinkedProcessorCategoryRecord(catalogRecord, categoryQuery) {
    const categoryIds = getLinkedRecordIds(catalogRecord, PCM_PROCESSOR_CATEGORY);

    if (categoryIds.length === 0) {
        return {
            status: "needs_review",
            message: "Processor Category must be linked before syncing to Square."
        };
    }

    if (categoryIds.length > 1) {
        return {
            status: "needs_review",
            message: `Processor Category must have exactly one linked category. Found ${categoryIds.length}.`
        };
    }

    const categoryRecord = categoryQuery.getRecord(categoryIds[0]);

    if (!categoryRecord) {
        return {
            status: "needs_review",
            message: `Linked Processor Category record could not be found: ${categoryIds[0]}`
        };
    }

    return {
        status: "ok",
        categoryRecord
    };
}

function validateProcessorCategory(categoryRecord) {
    const processor = getSelectName(categoryRecord, CAT_CATALOG_PROCESSOR);
    const environment = getSelectName(categoryRecord, CAT_PROCESSOR_ENVIRONMENT);
    const categoryId = normalizeText(categoryRecord.getCellValueAsString(CAT_PROCESSOR_CATEGORY_ID));
    const categoryName =
        normalizeText(categoryRecord.getCellValueAsString(CAT_PROCESSOR_CATEGORY_NAME)) ||
        normalizeText(categoryRecord.getCellValueAsString(CAT_AIRTABLE_CATEGORY_NAME));

    if (processor !== PROCESSOR_SQUARE) {
        throw new Error(`Linked Processor Category "${categoryName || categoryRecord.name}" must be ${PROCESSOR_SQUARE}; found "${processor || "blank"}".`);
    }

    if (environment !== ENVIRONMENT_PRODUCTION) {
        throw new Error(`Linked Processor Category "${categoryName || categoryRecord.name}" must be ${ENVIRONMENT_PRODUCTION}; found "${environment || "blank"}".`);
    }

    if (!categoryId) {
        throw new Error(`Processor Category "${categoryName || categoryRecord.name}" must be synced by CAT-0 before item sync. Processor Category ID is blank.`);
    }

    return {
        categoryId,
        categoryName
    };
}

function buildRecordPayload(catalogRecord, itemRecord, categoryRecord) {
    const categoryInfo = validateProcessorCategory(categoryRecord);

    const processorSku = normalizeText(catalogRecord.getCellValueAsString(PCM_PROCESSOR_SKU));
    const itemSku = normalizeText(itemRecord.getCellValueAsString(ITEM_SKU));

    const processorItemName = normalizeText(catalogRecord.getCellValueAsString(PCM_PROCESSOR_ITEM_NAME));
    const itemLibraryItemName = normalizeText(itemRecord.getCellValueAsString(ITEM_ITEM_NAME));

    const processorVariationName = normalizeText(catalogRecord.getCellValueAsString(PCM_PROCESSOR_VARIATION_NAME));
    const itemLibraryVariationName = normalizeText(itemRecord.getCellValueAsString(ITEM_VARIANT_NAME));

    const processorUnitPrice = catalogRecord.getCellValue(PCM_PROCESSOR_UNIT_PRICE);
    const itemLibraryUnitPrice = itemRecord.getCellValue(ITEM_UNIT_PRICE);

    const sku = processorSku || itemSku;
    const itemName = processorItemName || itemLibraryItemName;
    const variationName = processorVariationName || itemLibraryVariationName || "Regular";
    const unitPrice = processorUnitPrice !== null && processorUnitPrice !== undefined
        ? processorUnitPrice
        : itemLibraryUnitPrice;

    const priceAmount = dollarsToCents(unitPrice);

    if (!sku) {
        return {
            status: "needs_review",
            message: "Processor SKU is blank and linked ITEM LIBRARY SKU is blank."
        };
    }

    if (!itemName) {
        return {
            status: "needs_review",
            message: "Processor Item Name is blank and linked ITEM LIBRARY Item Name is blank."
        };
    }

    if (priceAmount === null) {
        return {
            status: "needs_review",
            message: "Processor Unit Price is blank/invalid and linked ITEM LIBRARY Unit Price is blank/invalid."
        };
    }

    return {
        status: "ok",
        payload: {
            recordId: catalogRecord.id,
            sku,
            itemName,
            variationName,
            priceAmount,
            barcodeValue: normalizeText(itemRecord.getCellValueAsString(ITEM_BARCODE_VALUE)),
            categoryRecordId: categoryRecord.id,
            categoryId: categoryInfo.categoryId,
            categoryName: categoryInfo.categoryName,
            existingItemId: normalizeText(catalogRecord.getCellValueAsString(PCM_PROCESSOR_ITEM_ID)),
            existingVariationId: normalizeText(catalogRecord.getCellValueAsString(PCM_PROCESSOR_VARIATION_ID)),
            existingItemVersion: getNumberVersion(catalogRecord.getCellValueAsString(PCM_PROCESSOR_CATALOG_VERSION))
        }
    };
}

function getGroupKey(payload) {
    return `${normalizeKey(payload.itemName)}||${payload.categoryRecordId}`;
}

async function markNeedsReview(recordId, message) {
    await processorCatalogMapTable.updateRecordAsync(recordId, {
        [PCM_SYNC_STATUS]: selectValue(STATUS_NEEDS_REVIEW),
        [PCM_SYNC_ERROR]: message
    });
}

async function markSyncErrorRecords(records, error, rawResponse = null) {
    const errorText = error?.message || String(error);
    const responseToSave = rawResponse || error?.squareResponse || { error: errorText };

    const updates = records
        .filter(record => getSelectName(record, PCM_SYNC_STATUS) === STATUS_READY_TO_SYNC)
        .map(record => ({
            id: record.id,
            fields: {
                [PCM_SYNC_STATUS]: selectValue(STATUS_SYNC_ERROR),
                [PCM_SYNC_ERROR]: errorText,
                [PCM_RAW_SYNC_RESPONSE]: safeStringify(responseToSave)
            }
        }));

    while (updates.length > 0) {
        await processorCatalogMapTable.updateRecordsAsync(updates.splice(0, 50));
    }

    output.set("result", "sync_error");
    output.set("error", errorText);
}

function getReturnedItemObject(response, itemId) {
    const objects = response.objects || [];
    return objects.find(object => object.id === itemId && object.type === "ITEM");
}

function getReturnedVariationFromItem(itemObject, variationId) {
    const variations = itemObject?.item_data?.variations || [];
    return variations.find(variation => variation.id === variationId);
}

function resolveReturnedId(response, originalId) {
    if (!originalId) return "";

    if (!originalId.startsWith("#")) {
        return originalId;
    }

    return getIdFromMappings(response.id_mappings, originalId) || originalId;
}

function buildSquareItemObjectForGroup(group) {
    const payloads = group.payloads;
    const first = payloads[0];

    const existingItemIds = Array.from(
        new Set(payloads.map(payload => payload.existingItemId).filter(Boolean))
    );

    if (existingItemIds.length > 1) {
        throw new Error(`Group "${first.itemName}" has multiple Processor Item IDs: ${existingItemIds.join(", ")}.`);
    }

    const itemId = existingItemIds[0] || makeTempItemId(first.itemName, first.categoryName, first.recordId);

    const existingVersions = payloads
        .map(payload => payload.existingItemVersion)
        .filter(value => Number.isFinite(value) && value > 0);

    const itemVersion = existingVersions.length > 0 ? Math.max(...existingVersions) : null;

    const seenSkus = new Set();
    const variations = [];

    for (const payload of payloads) {
        if (seenSkus.has(payload.sku)) {
            throw new Error(`Duplicate SKU "${payload.sku}" found in Square item group "${first.itemName}".`);
        }

        seenSkus.add(payload.sku);

        const variationId = payload.existingVariationId || makeTempVariationId(payload.sku, payload.recordId);

        const variationObject = {
            id: variationId,
            type: "ITEM_VARIATION",
            present_at_all_locations: true,
            item_variation_data: {
                item_id: itemId,
                name: payload.variationName,
                sku: payload.sku,
                pricing_type: "FIXED_PRICING",
                price_money: {
                    amount: payload.priceAmount,
                    currency: "USD"
                }
            }
        };

        if (payload.barcodeValue) {
            variationObject.item_variation_data.upc = payload.barcodeValue;
        }

        variations.push(variationObject);
    }

    const itemObject = {
        id: itemId,
        type: "ITEM",
        present_at_all_locations: true,
        item_data: {
            name: first.itemName,
            categories: [
                {
                    id: first.categoryId
                }
            ],
            reporting_category: {
                id: first.categoryId
            },
            variations
        }
    };

    if (itemVersion) {
        itemObject.version = itemVersion;
    }

    return {
        itemObject,
        itemId
    };
}

function buildPayloadsForRecords(records, itemQuery, categoryQuery) {
    const payloadsByRecordId = new Map();
    const reviewIssues = [];
    const syncErrors = [];

    for (const record of records) {
        const itemResult = getLinkedItemRecord(record, itemQuery);

        if (itemResult.status === "needs_review") {
            reviewIssues.push({ record, message: itemResult.message });
            continue;
        }

        const categoryResult = getLinkedProcessorCategoryRecord(record, categoryQuery);

        if (categoryResult.status === "needs_review") {
            reviewIssues.push({ record, message: categoryResult.message });
            continue;
        }

        try {
            const payloadResult = buildRecordPayload(record, itemResult.itemRecord, categoryResult.categoryRecord);

            if (payloadResult.status === "needs_review") {
                reviewIssues.push({ record, message: payloadResult.message });
                continue;
            }

            payloadsByRecordId.set(record.id, payloadResult.payload);
        } catch (error) {
            syncErrors.push({ record, error });
        }
    }

    return {
        payloadsByRecordId,
        reviewIssues,
        syncErrors
    };
}

async function markInitialIssues(reviewIssues, syncErrors) {
    for (const issue of reviewIssues) {
        await markNeedsReview(issue.record.id, issue.message);
    }

    for (const issue of syncErrors) {
        await processorCatalogMapTable.updateRecordAsync(issue.record.id, {
            [PCM_SYNC_STATUS]: selectValue(STATUS_SYNC_ERROR),
            [PCM_SYNC_ERROR]: issue.error.message || String(issue.error),
            [PCM_RAW_SYNC_RESPONSE]: safeStringify(issue.error.squareResponse || { error: issue.error.message || String(issue.error) })
        });
    }
}

function buildGroups(readyPayloads, candidatePayloads) {
    const readyGroupKeys = new Set(readyPayloads.map(getGroupKey));
    const groupsByKey = new Map();

    for (const payload of candidatePayloads) {
        const key = getGroupKey(payload);

        if (!readyGroupKeys.has(key)) {
            continue;
        }

        if (!groupsByKey.has(key)) {
            groupsByKey.set(key, {
                key,
                itemName: payload.itemName,
                categoryRecordId: payload.categoryRecordId,
                categoryId: payload.categoryId,
                categoryName: payload.categoryName,
                payloads: []
            });
        }

        groupsByKey.get(key).payloads.push(payload);
    }

    return Array.from(groupsByKey.values());
}

async function batchUpsertSquareItems(groups) {
    const squareObjects = [];
    const itemIdByGroupKey = new Map();

    for (const group of groups) {
        const build = buildSquareItemObjectForGroup(group);
        squareObjects.push(build.itemObject);
        itemIdByGroupKey.set(group.key, build.itemId);
    }

    const requestBody = {
        idempotency_key: `cat1-prod-batch-${Date.now()}`,
        batches: [
            {
                objects: squareObjects
            }
        ]
    };

    const response = await squareRequest("/v2/catalog/batch-upsert", "POST", requestBody);

    return {
        response,
        itemIdByGroupKey
    };
}

async function markBatchSynced(groups, batchResult) {
    const updates = [];
    const nowIso = new Date().toISOString();

    for (const group of groups) {
        const originalItemId = batchResult.itemIdByGroupKey.get(group.key);
        const resolvedItemId = resolveReturnedId(batchResult.response, originalItemId);
        const returnedItemObject = getReturnedItemObject(batchResult.response, resolvedItemId);
        const itemVersion = returnedItemObject?.version || "";

        if (!resolvedItemId || resolvedItemId.startsWith("#")) {
            throw new Error(`Square batch response did not return a real item ID for group "${group.itemName}".`);
        }

        for (const payload of group.payloads) {
            const originalVariationId = payload.existingVariationId || makeTempVariationId(payload.sku, payload.recordId);
            const resolvedVariationId = resolveReturnedId(batchResult.response, originalVariationId);
            const returnedVariation = getReturnedVariationFromItem(returnedItemObject, resolvedVariationId);

            if (!resolvedVariationId || resolvedVariationId.startsWith("#")) {
                throw new Error(`Square batch response did not return a real variation ID for SKU "${payload.sku}".`);
            }

            const rawResponse = {
                syncedAt: nowIso,
                groupKey: group.key,
                groupedSquareItemName: group.itemName,
                assignedCategoryId: payload.categoryId,
                assignedCategoryName: payload.categoryName,
                squareItemId: resolvedItemId,
                squareVariationId: resolvedVariationId,
                returnedVariation: returnedVariation || null,
                returnedItem: returnedItemObject || null,
                fullSquareResponse: batchResult.response
            };

            updates.push({
                id: payload.recordId,
                fields: {
                    [PCM_PROCESSOR_ITEM_ID]: resolvedItemId,
                    [PCM_PROCESSOR_VARIATION_ID]: resolvedVariationId,
                    [PCM_PROCESSOR_CATALOG_OBJECT_ID]: resolvedVariationId,
                    [PCM_PROCESSOR_CATALOG_VERSION]: itemVersion ? String(itemVersion) : "",
                    [PCM_SYNC_STATUS]: selectValue(STATUS_SYNCED),
                    [PCM_LAST_SYNC_AT]: nowIso,
                    [PCM_SYNC_ERROR]: "",
                    [PCM_RAW_SYNC_RESPONSE]: safeStringify(rawResponse)
                }
            });
        }
    }

    while (updates.length > 0) {
        await processorCatalogMapTable.updateRecordsAsync(updates.splice(0, 50));
    }

    output.set("result", "synced");
    output.set("syncedVariationCount", groups.reduce((sum, group) => sum + group.payloads.length, 0));
    output.set("syncedItemGroupCount", groups.length);
}

async function main() {
    if (!catalogMapRecordId) {
        throw new Error("Missing required input variable: catalogMapRecordId.");
    }

    const catalogQuery = await getProcessorCatalogMapRecords();
    const triggerRecord = catalogQuery.getRecord(catalogMapRecordId);

    if (!triggerRecord) {
        throw new Error(`Could not find triggering PROCESSOR CATALOG MAP record: ${catalogMapRecordId}`);
    }

    const itemQuery = await getItemLibraryRecords();
    const categoryQuery = await getProcessorCategoryMapRecords();

    const readyRecords = catalogQuery.records.filter(isReadyToSync);

    if (readyRecords.length === 0) {
        output.set("result", "no_ready_records");
        output.set("message", "No PROCESSOR CATALOG MAP records are currently READY TO SYNC.");
        return;
    }

    const candidateRecords = catalogQuery.records.filter(record => isReadyToSync(record) || isSynced(record));

    const readyBuild = buildPayloadsForRecords(readyRecords, itemQuery, categoryQuery);

    await markInitialIssues(readyBuild.reviewIssues, readyBuild.syncErrors);

    const validReadyPayloads = Array.from(readyBuild.payloadsByRecordId.values());

    if (validReadyPayloads.length === 0) {
        output.set("result", "no_valid_ready_records");
        output.set("message", "READY TO SYNC records were found, but none were valid for Square sync.");
        return;
    }

    const candidateBuild = buildPayloadsForRecords(candidateRecords, itemQuery, categoryQuery);
    const validCandidatePayloads = Array.from(candidateBuild.payloadsByRecordId.values());

    const groups = buildGroups(validReadyPayloads, validCandidatePayloads);

    if (groups.length === 0) {
        output.set("result", "no_valid_groups");
        output.set("message", "No valid Square item groups could be built.");
        return;
    }

    try {
        const batchResult = await batchUpsertSquareItems(groups);
        await markBatchSynced(groups, batchResult);
    } catch (error) {
        const involvedRecordIds = new Set();

        for (const group of groups) {
            for (const payload of group.payloads) {
                involvedRecordIds.add(payload.recordId);
            }
        }

        const involvedRecords = catalogQuery.records.filter(record => involvedRecordIds.has(record.id));
        await markSyncErrorRecords(involvedRecords, error);
    }
}

await main();
