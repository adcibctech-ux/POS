            PCM_PROCESSOR_VARIATION_ID,
            PCM_PROCESSOR_CATALOG_OBJECT_ID,
            PCM_PROCESSOR_ENVIRONMENT,
            PCM_SYNC_TO_PROCESSOR,
            PCM_SYNC_STATUS,
