const processorCatalogMapTable = base.getTable(PROCESSOR_CATALOG_MAP_TABLE_ID);
const itemLibraryTable = base.getTable(ITEM_LIBRARY_TABLE_ID);
const processorCategoryMapTable = base.getTable(PROCESSOR_CATEGORY_MAP_TABLE_ID);

function selectValue(name) {
    return { name };
}

function getSelectName(record, fieldName) {
    return record.getCellValue(fieldName)?.name || "";
}

function normalizeText(value) {
    if (value === null || value === undefined) return "";
    return String(value).trim();
}

function normalizeKey(value) {
    return normalizeText(value).toLowerCase();
}

function makeSafeSlug(value) {
    return normalizeText(value)
        .toUpperCase()
        .replace(/[^A-Z0-9]+/g, "-")
        .replace(/^-+|-+$/g, "")
        .slice(0, 60);
}

function safeStringify(value) {
    try {
        return JSON.stringify(value, null, 2);
    } catch (error) {
        return String(value);
    }
}

function getNumberVersion(value) {
    const numeric = Number(normalizeText(value));
    return Number.isFinite(numeric) && numeric > 0 ? numeric : null;
}

function dollarsToCents(value) {
    const numeric = Number(value);

    if (!Number.isFinite(numeric)) {
        return null;
    }

    return Math.round(numeric * 100);
}

function getLinkedRecordIds(record, fieldName) {
    const links = record.getCellValue(fieldName) || [];
    return links.map(link => link.id);
}

function getIdFromMappings(idMappings, clientObjectId) {
    const mapping = (idMappings || []).find(item =>
        item.client_object_id === clientObjectId ||
        item.clientObjectId === clientObjectId
    );

    return mapping?.object_id || mapping?.objectId || null;
}

function makeTempItemId(itemName, categoryName, fallbackId) {
    const safeItem = makeSafeSlug(itemName);
    const safeCategory = makeSafeSlug(categoryName);
    const baseId = [safeItem, safeCategory].filter(Boolean).join("-");
    return `#ITEM-${baseId || fallbackId}`;
}

function makeTempVariationId(sku, fallbackId) {
    const safeSku = makeSafeSlug(sku);
    return `#VARIATION-${safeSku || fallbackId}`;
}

async function squareRequest(path, method, body) {
    const response = await fetch(`${SQUARE_BASE_URL}${path}`, {
        method,
        headers: {
            "Square-Version": SQUARE_VERSION,
            "Authorization": `Bearer ${SQUARE_ACCESS_TOKEN}`,
            "Content-Type": "application/json"
        },
        body: body ? JSON.stringify(body) : undefined
    });

    const text = await response.text();
    let json;

    try {
        json = text ? JSON.parse(text) : {};
    } catch (error) {
        json = { rawText: text };
    }

    if (!response.ok) {
        const errorMessage = json?.errors
            ? json.errors.map(err => `${err.code || "ERROR"}: ${err.detail || err.field || ""}`).join(" | ")
            : `Square request failed with status ${response.status}`;

        const error = new Error(errorMessage);
        error.squareResponse = json;
        error.status = response.status;
        throw error;
    }

    return json;
}

