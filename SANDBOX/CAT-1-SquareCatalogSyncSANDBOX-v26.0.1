/***************************************************************
 * SCRIPT: CAT-1-SquareCatalogSyncSANDBOX-v26.0.1
 * SYSTEM: ADC|IBC POS Backend
 * TABLE(S): PROCESSOR CATALOG MAP, ITEM LIBRARY
 *
 * PURPOSE:
 * Pushes one Airtable processor catalog map record to Square
 * SANDBOX and writes returned Square catalog IDs back to Airtable.
 *
 * VERSIONING:
 * CAT-1-SquareCatalogSyncSANDBOX-v26.0.1
 *
 * Version format:
 * - CAT-1 = catalog sync workflow/script number.
 * - v26 = 2026 system standard.
 * - .0 = first CAT-1 logic release.
 * - .1 = select option capitalization bug-fix iteration.
 *
 * SCRIPT BEHAVIOR:
 * Same behavior as CAT-1-SquareCatalogSync-v26.0.1, but:
 * - requires Processor Environment = SANDBOX
 * - uses the Square sandbox endpoint
 * - uses SQUARE_SANDBOX_ACCESS_TOKEN
 *
 * BUG FIXES / REVISION NOTES:
 * v26.0.1
 * - Updated single-select values to match all-caps Airtable options.
 * - Sync Status now writes READY TO SYNC, SYNCED, SYNC ERROR, NEEDS REVIEW.
 * - Catalog Processor now expects SQUARE.
 * - Processor Environment now expects SANDBOX.
 *
 * v26.0.0
 * - Initial sandbox Square catalog sync release.
 *
 * REQUIRED AIRTABLE AUTOMATION INPUTS:
 * - catalogMapRecordId
 *
 * REQUIRED AIRTABLE SECRET:
 * - SQUARE_SANDBOX_ACCESS_TOKEN
 ***************************************************************/

const config = input.config();
const catalogMapRecordId = config.catalogMapRecordId;

const SQUARE_VERSION = "2026-05-20";
const SQUARE_BASE_URL = "https://connect.squareupsandbox.com";
const SQUARE_ACCESS_TOKEN = input.secret("SQUARE_SANDBOX_ACCESS_TOKEN");

const CATALOG_MAP_TABLE_ID = "tbliIMV8WXiUCmpWd";
const ITEM_LIBRARY_TABLE = "ITEM LIBRARY";

// PROCESSOR CATALOG MAP fields
const MAP_ITEM = "Item";
const MAP_CATALOG_PROCESSOR = "Catalog Processor";
const MAP_PROCESSOR_ENVIRONMENT = "Processor Environment";
const MAP_PROCESSOR_ITEM_ID = "Processor Item ID";
const MAP_PROCESSOR_VARIATION_ID = "Processor Variation ID";
const MAP_PROCESSOR_CATALOG_OBJECT_ID = "Processor Catalog Object ID";
const MAP_PROCESSOR_SKU = "Processor SKU";
const MAP_PROCESSOR_ITEM_NAME = "Processor Item Name";
const MAP_PROCESSOR_VARIATION_NAME = "Processor Variation Name";
const MAP_PROCESSOR_UNIT_PRICE = "Processor Unit Price";
const MAP_SYNC_TO_PROCESSOR = "Sync to Processor?";
const MAP_SYNC_STATUS = "Sync Status";
const MAP_LAST_SYNC_AT = "Last Sync At";
const MAP_PROCESSOR_CATALOG_VERSION = "Processor Catalog Version";
const MAP_SYNC_ERROR = "Sync Error";
const MAP_RAW_SYNC_RESPONSE = "Raw Sync Response";

// ITEM LIBRARY fallback fields
const ITEM_SKU = "SKU";
const ITEM_NAME = "Item Name";
const ITEM_VARIANT_NAME = "Variant Name";
const ITEM_UNIT_PRICE = "Unit Price";
const ITEM_ACTIVE = "Active?";

// All-caps Airtable select option values
const PROCESSOR_SQUARE = "SQUARE";
const ENVIRONMENT_SANDBOX = "SANDBOX";
const STATUS_READY_TO_SYNC = "READY TO SYNC";
const STATUS_SYNCED = "SYNCED";
const STATUS_SYNC_ERROR = "SYNC ERROR";
const STATUS_NEEDS_REVIEW = "NEEDS REVIEW";

const catalogMapTable = base.getTable(CATALOG_MAP_TABLE_ID);
const itemLibraryTable = base.getTable(ITEM_LIBRARY_TABLE);

function selectValue(name) {
    return { name };
}

function getSelectName(record, fieldName) {
    return record.getCellValue(fieldName)?.name || "";
}

function getFirstLinkedRecordId(record, fieldName) {
    const linked = record.getCellValue(fieldName) || [];
    return linked.length ? linked[0].id : null;
}

function normalizeText(value) {
    if (value === null || value === undefined) {
        return "";
    }
    return String(value).trim();
}

function toCents(value) {
    const numeric = Number(value);
    if (!Number.isFinite(numeric)) {
        return null;
    }
    return Math.round(numeric * 100);
}

function makeTempId(value, fallback) {
    const baseValue = normalizeText(value || fallback || "OBJECT")
        .toUpperCase()
        .replace(/[^A-Z0-9]+/g, "-")
        .replace(/^-+|-+$/g, "")
        .slice(0, 60);

    return `#${baseValue || "OBJECT"}`;
}

function safeStringify(value) {
    try {
        return JSON.stringify(value, null, 2);
    } catch (error) {
        return String(value);
    }
}

function getIdFromMappings(idMappings, clientObjectId) {
    const mapping = (idMappings || []).find(item => item.client_object_id === clientObjectId);
    return mapping?.object_id || null;
}

function getNumberVersion(value) {
    const numeric = Number(normalizeText(value));
    return Number.isFinite(numeric) && numeric > 0 ? numeric : null;
}

async function squareRequest(path, method, body) {
    const response = await fetch(`${SQUARE_BASE_URL}${path}`, {
        method,
        headers: {
            "Square-Version": SQUARE_VERSION,
            "Authorization": `Bearer ${SQUARE_ACCESS_TOKEN}`,
            "Content-Type": "application/json"
        },
        body: body ? JSON.stringify(body) : undefined
    });

    const text = await response.text();
    let json;

    try {
        json = text ? JSON.parse(text) : {};
    } catch (error) {
        json = { rawText: text };
    }

    if (!response.ok) {
        const errorMessage = json?.errors
            ? json.errors.map(err => `${err.code || "ERROR"}: ${err.detail || err.field || ""}`).join(" | ")
            : `Square request failed with status ${response.status}`;

        const error = new Error(errorMessage);
        error.squareResponse = json;
        error.status = response.status;
        throw error;
    }

    return json;
}

async function markSyncError(recordId, error, rawResponse = null) {
    const errorText = error?.message || String(error);
    const responseToSave = rawResponse || error?.squareResponse || { error: errorText };

    await catalogMapTable.updateRecordAsync(recordId, {
        [MAP_SYNC_STATUS]: selectValue(STATUS_SYNC_ERROR),
        [MAP_SYNC_ERROR]: errorText,
        [MAP_RAW_SYNC_RESPONSE]: safeStringify(responseToSave)
    });

    output.set("result", "sync_error");
    output.set("error", errorText);
}

async function getCatalogMapRecord(recordId) {
    const query = await catalogMapTable.selectRecordsAsync({
        fields: [
            MAP_ITEM,
            MAP_CATALOG_PROCESSOR,
            MAP_PROCESSOR_ENVIRONMENT,
            MAP_PROCESSOR_ITEM_ID,
            MAP_PROCESSOR_VARIATION_ID,
            MAP_PROCESSOR_CATALOG_OBJECT_ID,
            MAP_PROCESSOR_SKU,
            MAP_PROCESSOR_ITEM_NAME,
            MAP_PROCESSOR_VARIATION_NAME,
            MAP_PROCESSOR_UNIT_PRICE,
            MAP_SYNC_TO_PROCESSOR,
            MAP_SYNC_STATUS,
            MAP_LAST_SYNC_AT,
            MAP_PROCESSOR_CATALOG_VERSION,
            MAP_SYNC_ERROR,
            MAP_RAW_SYNC_RESPONSE
        ]
    });

    return query.getRecord(recordId);
}

async function getLinkedItemRecord(itemRecordId) {
    if (!itemRecordId) {
        return null;
    }

    const query = await itemLibraryTable.selectRecordsAsync({
        fields: [
            ITEM_SKU,
            ITEM_NAME,
            ITEM_VARIANT_NAME,
            ITEM_UNIT_PRICE,
            ITEM_ACTIVE
        ]
    });

    return query.getRecord(itemRecordId);
}

function buildSyncPayload(mapRecord, itemRecord) {
    const processorSku = normalizeText(mapRecord.getCellValueAsString(MAP_PROCESSOR_SKU)) ||
        normalizeText(itemRecord?.getCellValueAsString(ITEM_SKU));

    const processorItemName = normalizeText(mapRecord.getCellValueAsString(MAP_PROCESSOR_ITEM_NAME)) ||
        normalizeText(itemRecord?.getCellValueAsString(ITEM_NAME));

    const processorVariationName = normalizeText(mapRecord.getCellValueAsString(MAP_PROCESSOR_VARIATION_NAME)) ||
        normalizeText(itemRecord?.getCellValueAsString(ITEM_VARIANT_NAME)) ||
        "Default";

    const processorUnitPrice = mapRecord.getCellValue(MAP_PROCESSOR_UNIT_PRICE) ??
        itemRecord?.getCellValue(ITEM_UNIT_PRICE);

    const amountCents = toCents(processorUnitPrice);

    if (!processorSku) {
        throw new Error("Missing Processor SKU and linked item SKU.");
    }

    if (!processorItemName) {
        throw new Error("Missing Processor Item Name and linked item name.");
    }

    if (!processorVariationName) {
        throw new Error("Missing Processor Variation Name and linked variant name.");
    }

    if (amountCents === null) {
        throw new Error("Missing or invalid Processor Unit Price.");
    }

    return {
        processorSku,
        processorItemName,
        processorVariationName,
        amountCents
    };
}

function validateRecordForSandboxSync(mapRecord) {
    const processor = getSelectName(mapRecord, MAP_CATALOG_PROCESSOR);
    const environment = getSelectName(mapRecord, MAP_PROCESSOR_ENVIRONMENT);
    const syncStatus = getSelectName(mapRecord, MAP_SYNC_STATUS);
    const syncToProcessor = mapRecord.getCellValue(MAP_SYNC_TO_PROCESSOR) === true;

    if (processor !== PROCESSOR_SQUARE) {
        throw new Error(`Catalog Processor must be ${PROCESSOR_SQUARE}; found "${processor || "blank"}".`);
    }

    if (environment !== ENVIRONMENT_SANDBOX) {
        throw new Error(`Processor Environment must be ${ENVIRONMENT_SANDBOX}; found "${environment || "blank"}".`);
    }

    if (!syncToProcessor) {
        throw new Error("Sync to Processor? must be checked.");
    }

    if (syncStatus !== STATUS_READY_TO_SYNC) {
        throw new Error(`Sync Status must be ${STATUS_READY_TO_SYNC}; found "${syncStatus || "blank"}".`);
    }
}

async function createSquareCatalogObject(mapRecord, payload) {
    const tempItemId = makeTempId(payload.processorSku, "ITEM");
    const tempVariationId = makeTempId(`${payload.processorSku}-VAR`, "ITEM-VARIATION");

    const requestBody = {
        idempotency_key: `cat1-sandbox-create-${mapRecord.id}`,
        object: {
            id: tempItemId,
            type: "ITEM",
            present_at_all_locations: true,
            item_data: {
                name: payload.processorItemName,
                variations: [
                    {
                        id: tempVariationId,
                        type: "ITEM_VARIATION",
                        present_at_all_locations: true,
                        item_variation_data: {
                            item_id: tempItemId,
                            name: payload.processorVariationName,
                            sku: payload.processorSku,
                            pricing_type: "FIXED_PRICING",
                            price_money: {
                                amount: payload.amountCents,
                                currency: "USD"
                            }
                        }
                    }
                ]
            }
        }
    };

    const response = await squareRequest("/v2/catalog/object", "POST", requestBody);

    const itemId = response.catalog_object?.id ||
        getIdFromMappings(response.id_mappings, tempItemId);

    const variation = response.catalog_object?.item_data?.variations?.[0];
    const variationId = variation?.id ||
        getIdFromMappings(response.id_mappings, tempVariationId);

    const version = variation?.version || response.catalog_object?.version;

    if (!itemId || !variationId) {
        throw new Error("Square create succeeded but returned missing item or variation ID.");
    }

    return {
        response,
        itemId,
        variationId,
        catalogObjectId: variationId,
        version
    };
}

async function updateSquareCatalogObject(mapRecord, payload) {
    const itemId = normalizeText(mapRecord.getCellValueAsString(MAP_PROCESSOR_ITEM_ID));
    const variationId = normalizeText(mapRecord.getCellValueAsString(MAP_PROCESSOR_VARIATION_ID));
    const existingVersion = getNumberVersion(mapRecord.getCellValueAsString(MAP_PROCESSOR_CATALOG_VERSION));

    if (!itemId || !variationId) {
        throw new Error("Cannot update because Processor Item ID or Processor Variation ID is blank.");
    }

    const object = {
        id: variationId,
        type: "ITEM_VARIATION",
        present_at_all_locations: true,
        item_variation_data: {
            item_id: itemId,
            name: payload.processorVariationName,
            sku: payload.processorSku,
            pricing_type: "FIXED_PRICING",
            price_money: {
                amount: payload.amountCents,
                currency: "USD"
            }
        }
    };

    if (existingVersion) {
        object.version = existingVersion;
    }

    const requestBody = {
        idempotency_key: `cat1-sandbox-update-${mapRecord.id}-${Date.now()}`,
        object
    };

    const response = await squareRequest("/v2/catalog/object", "POST", requestBody);
    const returnedObject = response.catalog_object || {};

    return {
        response,
        itemId,
        variationId: returnedObject.id || variationId,
        catalogObjectId: returnedObject.id || variationId,
        version: returnedObject.version
    };
}

async function markSynced(recordId, syncResult) {
    await catalogMapTable.updateRecordAsync(recordId, {
        [MAP_PROCESSOR_ITEM_ID]: syncResult.itemId,
        [MAP_PROCESSOR_VARIATION_ID]: syncResult.variationId,
        [MAP_PROCESSOR_CATALOG_OBJECT_ID]: syncResult.catalogObjectId,
        [MAP_PROCESSOR_CATALOG_VERSION]: syncResult.version ? String(syncResult.version) : "",
        [MAP_SYNC_STATUS]: selectValue(STATUS_SYNCED),
        [MAP_LAST_SYNC_AT]: new Date().toISOString(),
        [MAP_SYNC_ERROR]: "",
        [MAP_RAW_SYNC_RESPONSE]: safeStringify(syncResult.response)
    });

    output.set("result", "synced");
    output.set("processorItemId", syncResult.itemId);
    output.set("processorVariationId", syncResult.variationId);
    output.set("processorCatalogObjectId", syncResult.catalogObjectId);
}

async function main() {
    if (!catalogMapRecordId) {
        throw new Error("Missing required input variable: catalogMapRecordId.");
    }

    const mapRecord = await getCatalogMapRecord(catalogMapRecordId);

    if (!mapRecord) {
        throw new Error(`Could not find catalog map record: ${catalogMapRecordId}`);
    }

    try {
        validateRecordForSandboxSync(mapRecord);

        const itemRecordId = getFirstLinkedRecordId(mapRecord, MAP_ITEM);
        const itemRecord = await getLinkedItemRecord(itemRecordId);

        if (!itemRecord) {
            throw new Error("Catalog map record must link to one ITEM LIBRARY record.");
        }

        const payload = buildSyncPayload(mapRecord, itemRecord);

        const existingItemId = normalizeText(mapRecord.getCellValueAsString(MAP_PROCESSOR_ITEM_ID));
        const existingVariationId = normalizeText(mapRecord.getCellValueAsString(MAP_PROCESSOR_VARIATION_ID));

        const syncResult = existingItemId && existingVariationId
            ? await updateSquareCatalogObject(mapRecord, payload)
            : await createSquareCatalogObject(mapRecord, payload);

        await markSynced(mapRecord.id, syncResult);
    } catch (error) {
        await markSyncError(mapRecord.id, error);
    }
}

await main();
