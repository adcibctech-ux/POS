/***************************************************************
 * SCRIPT: POS-2-SquareLookup-v26.0.1
 * SYSTEM: ADC|IBC POS Backend
 * TABLE(S): SYNC LOG, TRANSACTIONS
 *
 * PURPOSE:
 * Reads a SYNC LOG webhook record, retrieves the related Square
 * payment from the Square Sandbox Payments API, optionally retrieves
 * the related Square order from the Square Sandbox Orders API, and
 * creates or updates the parent TRANSACTIONS record in Airtable.
 *
 * VERSIONING:
 * POS-2-SquareLookup-v26.0.1
 *
 * Version format:
 * - First digit: major POS workflow/script number.
 * - Second digit: major structural version.
 * - Third digit: revision number.
 *
 * For this script family, POS-2 remains constant.
 * Increment the third digit for each revision:
 * - POS-2-SquareLookup-v26.0.0 = first iteration
 * - POS-2-SquareLookup-v26.0.1 = first revision
 *
 * SCRIPT BEHAVIOR:
 * 1. Reads the triggering SYNC LOG record ID from the Airtable
 *    automation input variable named `syncLogRecordId`.
 * 2. Confirms the webhook event is payment.created or payment.updated.
 * 3. Reads Square Object ID from the triggering SYNC LOG record.
 * 4. Treats Square Object ID as the Square Payment ID for payment
 *    webhook events.
 * 5. Finds other SYNC LOG records with the same Square Object ID.
 * 6. Keeps the newest eligible payment.updated event when possible.
 * 7. Marks older same-payment webhook records as Duplicate/Resolved.
 * 8. Calls the Square Sandbox Payments API to retrieve payment details.
 * 9. If the payment has a Square Order ID, calls the Square Sandbox
 *    Orders API to retrieve order details.
 * 10. Searches TRANSACTIONS for an existing record with the same
 *     Square Payment ID.
 * 11. Updates the existing TRANSACTIONS record if found.
 * 12. Creates a new TRANSACTIONS record if no matching Square Payment ID
 *     exists.
 * 13. Links the TRANSACTIONS record back to the triggering SYNC LOG record.
 * 14. Stores combined Square payment/order API response JSON in
 *     SYNC LOG.Raw API Response.
 * 15. Sets SYNC LOG.Processing Status to Processed on success.
 * 16. Sets SYNC LOG.Automation Step to Payment Retrieved on success.
 * 17. Sets TRANSACTIONS.Import Status to API Retrieved on success.
 * 18. Checks TRANSACTIONS.Transaction Processed? after parent
 *     transaction creation/update succeeds.
 * 19. Does not create TRANSACTION LINES.
 * 20. Does not create INVENTORY MOVEMENTS.
 *
 * BUG FIXES / REVISION NOTES:
 * v26.0.1
 * - Fixed TRANSACTIONS.Payment Type field name after trailing space
 *   was removed.
 * - Added non-payment webhook guard.
 * - Added same-payment webhook duplicate handling.
 * - Added newest-payment-event preference logic.
 * - Reduced catch-block Airtable writes to avoid masking the original
 *   failure with "Request processing is disabled due to earlier failed request."
 * - Added safer single-select handling for fields that may not have
 *   every Square status/type as an Airtable option.
 *
 * v26.0.0
 * - Initial Square API lookup script.
 * - Added Square Sandbox Payments API retrieval.
 * - Added optional Square Sandbox Orders API retrieval.
 * - Added parent TRANSACTIONS create/update by Square Payment ID.
 * - Added SYNC LOG back-linking to created/updated transaction.
 * - Added Raw API Response storage.
 * - Added basic error handling and SYNC LOG failure updates.
 *
 * REQUIRED AIRTABLE AUTOMATION INPUTS:
 * - syncLogRecordId: Record ID of the triggering SYNC LOG record.
 *
 * REQUIRED AIRTABLE SECRET:
 * - SQUARE_SANDBOX_ACCESS_TOKEN
 *
 * REQUIRED TABLES:
 * - SYNC LOG
 * - TRANSACTIONS
 ***************************************************************/

const config = input.config();

const syncLogRecordId = config.syncLogRecordId;
const squareAccessToken = input.secret("SQUARE_SANDBOX_ACCESS_TOKEN");

const SQUARE_API_VERSION = "2026-05-20";
const SQUARE_BASE_URL = "https://connect.squareupsandbox.com";

const SYNC_LOG_TABLE = "SYNC LOG";
const TRANSACTIONS_TABLE = "TRANSACTIONS";

// SYNC LOG fields
const SL_SQUARE_EVENT_ID = "Square Event ID";
const SL_PROCESSING_STATUS = "Processing Status";
const SL_EVENT_TYPE = "Event Type";
const SL_SQUARE_OBJECT_ID = "Square Object ID";
const SL_RELATED_TRANSACTION = "Related Transaction";
const SL_RAW_API_RESPONSE = "Raw API Response";
const SL_ERROR_MESSAGE = "Error Message";
const SL_AUTOMATION_STEP = "Automation Step";
const SL_RETRY_COUNT = "Retry Count";
const SL_LAST_RETRY_AT = "Last Retry At";
const SL_RESOLVED = "Resolved?";
const SL_RESOLVED_NOTES = "Resolved Notes";
const SL_RECEIVED_AT = "Received At";

// TRANSACTIONS fields
const TX_SQUARE_PAYMENT_ID = "Square Payment ID";
const TX_SQUARE_TRANSACTION_ID = "Square Transaction ID";
const TX_SQUARE_ORDER_ID = "Square Order ID";
const TX_TRANSACTION_TIMESTAMP = "Transaction Timestamp";
const TX_PAYMENT_STATUS = "Payment Status";
const TX_PAYMENT_TYPE = "Payment Type";
const TX_GROSS_SALE = "Gross Sale";
const TX_TAX_TOTAL = "Tax Total";
const TX_DISCOUNT_TOTAL = "Discount Total";
const TX_PROCESSING_FEE = "Processing Fee";
const TX_NET_TOTAL = "Net Total";
const TX_SQUARE_LOCATION_ID = "Square Location ID";
const TX_SQUARE_STAFF_ID = "Square Staff ID";
const TX_SQUARE_DEVICE_ID = "Square Device ID";
const TX_SQUARE_LOCATION_NAME = "Square Location Name";
const TX_SQUARE_DEVICE_NAME = "Square Device Name";
const TX_CARD_BRAND = "Card Brand";
const TX_RECEIPT_URL = "Receipt URL";
const TX_IMPORT_STATUS = "Import Status";
const TX_RAW_PAYLOAD = "Raw Payload";
const TX_WEBHOOK_EVENTS = "Webhook Events";
const TX_PRIMARY_WEBHOOK_EVENT_ID = "Primary Webhook Event ID";
const TX_TRANSACTION_PROCESSED = "Transaction Processed?";

// Select values
const STATUS_PROCESSED = "Processed";
const STATUS_FAILED = "Failed";
const STATUS_DUPLICATE = "Duplicate";

const STEP_PAYMENT_RETRIEVED = "Payment Retrieved";
const STEP_FAILED = "Failed";
const STEP_DUPLICATE = "Duplicate";

const IMPORT_STATUS_API_RETRIEVED = "API Retrieved";

const PAYMENT_EVENTS = new Set(["payment.created", "payment.updated"]);

const syncLogTable = base.getTable(SYNC_LOG_TABLE);
const transactionsTable = base.getTable(TRANSACTIONS_TABLE);

function stringifySafe(value) {
    try {
        return JSON.stringify(value, null, 2);
    } catch (error) {
        return String(value);
    }
}

function centsToDollars(moneyObject) {
    if (!moneyObject || typeof moneyObject.amount !== "number") {
        return null;
    }
    return moneyObject.amount / 100;
}

function sumProcessingFees(processingFeeArray) {
    if (!Array.isArray(processingFeeArray)) {
        return 0;
    }

    return processingFeeArray.reduce((sum, fee) => {
        return sum + (fee?.amount_money?.amount || 0);
    }, 0) / 100;
}

function getString(record, fieldName) {
    return record.getCellValueAsString(fieldName).trim();
}

function getReceivedTime(record) {
    const receivedAt = record.getCellValue(SL_RECEIVED_AT);
    const createdTime = record.createdTime;

    return new Date(receivedAt || createdTime).getTime();
}

function buildSelect(name) {
    if (!name) {
        return null;
    }
    return { name };
}

function removeNullValues(fieldsObject) {
    const cleaned = {};

    for (const [key, value] of Object.entries(fieldsObject)) {
        if (value !== null && value !== undefined) {
            cleaned[key] = value;
        }
    }

    return cleaned;
}

async function squareGet(path) {
    const response = await fetch(`${SQUARE_BASE_URL}${path}`, {
        method: "GET",
        headers: {
            "Square-Version": SQUARE_API_VERSION,
            "Authorization": `Bearer ${squareAccessToken}`,
            "Content-Type": "application/json"
        }
    });

    const responseText = await response.text();

    let responseJson;
    try {
        responseJson = JSON.parse(responseText);
    } catch (error) {
        responseJson = { rawResponseText: responseText };
    }

    if (!response.ok) {
        throw new Error(
            `Square API request failed for ${path}. Status ${response.status}: ${stringifySafe(responseJson)}`
        );
    }

    return responseJson;
}

async function findTransactionByPaymentId(squarePaymentId) {
    const transactionRecords = await transactionsTable.selectRecordsAsync({
        fields: [TX_SQUARE_PAYMENT_ID]
    });

    return transactionRecords.records.find(record => {
        return record.getCellValueAsString(TX_SQUARE_PAYMENT_ID) === squarePaymentId;
    }) || null;
}

function selectNewestEligiblePaymentSyncLog(recordsForSamePayment) {
    const eligible = recordsForSamePayment.filter(record => {
        const status = getString(record, SL_PROCESSING_STATUS);
        const step = getString(record, SL_AUTOMATION_STEP);
        const eventType = getString(record, SL_EVENT_TYPE);
        const resolved = record.getCellValue(SL_RESOLVED);

        return (
            status === "Received" &&
            step === "Webhook Received" &&
            PAYMENT_EVENTS.has(eventType) &&
            !resolved
        );
    });

    const updatedEvents = eligible.filter(record => {
        return getString(record, SL_EVENT_TYPE) === "payment.updated";
    });

    const candidates = updatedEvents.length > 0 ? updatedEvents : eligible;

    candidates.sort((a, b) => {
        return getReceivedTime(b) - getReceivedTime(a);
    });

    return candidates[0] || null;
}

async function markOlderSamePaymentRecordsAsDuplicate(recordsForSamePayment, keeperRecordId) {
    const updates = [];

    for (const record of recordsForSamePayment) {
        if (record.id === keeperRecordId) {
            continue;
        }

        const status = getString(record, SL_PROCESSING_STATUS);
        const step = getString(record, SL_AUTOMATION_STEP);
        const eventType = getString(record, SL_EVENT_TYPE);
        const resolved = record.getCellValue(SL_RESOLVED);

        if (
            status === "Received" &&
            step === "Webhook Received" &&
            PAYMENT_EVENTS.has(eventType) &&
            !resolved
        ) {
            updates.push({
                id: record.id,
                fields: {
                    [SL_PROCESSING_STATUS]: { name: STATUS_DUPLICATE },
                    [SL_AUTOMATION_STEP]: { name: STEP_DUPLICATE },
                    [SL_RESOLVED]: true,
                    [SL_RESOLVED_NOTES]: "Older webhook for same Square Payment ID. Newer eligible payment event was selected for POS-2 processing."
                }
            });
        }
    }

    while (updates.length > 0) {
        await syncLogTable.updateRecordsAsync(updates.splice(0, 50));
    }
}

function buildTransactionFields({
    payment,
    order,
    syncLogRecordId,
    squareEventId,
    rawApiResponseText,
    existingWebhookEventIds
}) {
    const grossSale =
        centsToDollars(order?.total_money) ??
        centsToDollars(payment.total_money) ??
        centsToDollars(payment.amount_money);

    const taxTotal = centsToDollars(order?.total_tax_money) ?? 0;
    const discountTotal = centsToDollars(order?.total_discount_money) ?? 0;
    const processingFeeTotal = sumProcessingFees(payment.processing_fee);

    const netTotal =
        centsToDollars(payment.total_money) ??
        centsToDollars(payment.amount_money) ??
        grossSale;

    const paymentType = payment.source_type || "";
    const cardBrand = payment.card_details?.card?.card_brand || "";

    const webhookEvents = existingWebhookEventIds.includes(syncLogRecordId)
        ? existingWebhookEventIds.map(id => ({ id }))
        : [...existingWebhookEventIds, syncLogRecordId].map(id => ({ id }));

    return removeNullValues({
        [TX_SQUARE_PAYMENT_ID]: payment.id || "",
        [TX_SQUARE_TRANSACTION_ID]: payment.id || "",
        [TX_SQUARE_ORDER_ID]: payment.order_id || "",
        [TX_TRANSACTION_TIMESTAMP]: payment.created_at || null,
        [TX_PAYMENT_STATUS]: buildSelect(payment.status),
        [TX_PAYMENT_TYPE]: buildSelect(paymentType),
        [TX_GROSS_SALE]: grossSale,
        [TX_TAX_TOTAL]: taxTotal,
        [TX_DISCOUNT_TOTAL]: discountTotal,
        [TX_PROCESSING_FEE]: processingFeeTotal,
        [TX_NET_TOTAL]: netTotal,
        [TX_SQUARE_LOCATION_ID]: payment.location_id || order?.location_id || "",
        [TX_SQUARE_STAFF_ID]: payment.team_member_id || payment.employee_id || "",
        [TX_SQUARE_DEVICE_ID]: payment.device_details?.device_id || "",
        [TX_SQUARE_LOCATION_NAME]: "",
        [TX_SQUARE_DEVICE_NAME]: payment.device_details?.device_name || "",
        [TX_CARD_BRAND]: cardBrand,
        [TX_RECEIPT_URL]: payment.receipt_url || "",
        [TX_IMPORT_STATUS]: { name: IMPORT_STATUS_API_RETRIEVED },
        [TX_RAW_PAYLOAD]: rawApiResponseText,
        [TX_WEBHOOK_EVENTS]: webhookEvents,
        [TX_PRIMARY_WEBHOOK_EVENT_ID]: squareEventId,
        [TX_TRANSACTION_PROCESSED]: true
    });
}

try {
    if (!syncLogRecordId) {
        throw new Error("Missing required input variable: syncLogRecordId.");
    }

    if (!squareAccessToken) {
        throw new Error("Missing Airtable secret: SQUARE_SANDBOX_ACCESS_TOKEN.");
    }

    const syncLogQuery = await syncLogTable.selectRecordsAsync({
        fields: [
            SL_SQUARE_EVENT_ID,
            SL_PROCESSING_STATUS,
            SL_EVENT_TYPE,
            SL_SQUARE_OBJECT_ID,
            SL_AUTOMATION_STEP,
            SL_RESOLVED,
            SL_RECEIVED_AT
        ]
    });

    const syncLogRecord = syncLogQuery.getRecord(syncLogRecordId);

    if (!syncLogRecord) {
        throw new Error(`Could not find SYNC LOG record: ${syncLogRecordId}`);
    }

    const eventType = getString(syncLogRecord, SL_EVENT_TYPE);
    const squarePaymentId = getString(syncLogRecord, SL_SQUARE_OBJECT_ID);
    const squareEventId = getString(syncLogRecord, SL_SQUARE_EVENT_ID);

    if (!PAYMENT_EVENTS.has(eventType)) {
        await syncLogTable.updateRecordAsync(syncLogRecord.id, {
            [SL_PROCESSING_STATUS]: { name: STATUS_DUPLICATE },
            [SL_AUTOMATION_STEP]: { name: STEP_DUPLICATE },
            [SL_RESOLVED]: true,
            [SL_RESOLVED_NOTES]: `POS-2 skipped this record because Event Type is ${eventType}, not a payment event.`
        });

        output.set("result", "skipped_non_payment_event");
        output.set("eventType", eventType);
        return;
    }

    if (!squarePaymentId) {
        throw new Error("SYNC LOG.Square Object ID is blank. Cannot retrieve Square payment.");
    }

    const recordsForSamePayment = syncLogQuery.records.filter(record => {
        return getString(record, SL_SQUARE_OBJECT_ID) === squarePaymentId;
    });

    const keeperRecord = selectNewestEligiblePaymentSyncLog(recordsForSamePayment);

    if (!keeperRecord) {
        output.set("result", "no_eligible_payment_record");
        output.set("squarePaymentId", squarePaymentId);
        return;
    }

    if (keeperRecord.id !== syncLogRecord.id) {
        await syncLogTable.updateRecordAsync(syncLogRecord.id, {
            [SL_PROCESSING_STATUS]: { name: STATUS_DUPLICATE },
            [SL_AUTOMATION_STEP]: { name: STEP_DUPLICATE },
            [SL_RESOLVED]: true,
            [SL_RESOLVED_NOTES]: `Skipped because newer eligible payment webhook ${keeperRecord.id} was selected for POS-2 processing.`
        });

        output.set("result", "skipped_older_payment_event");
        output.set("selectedSyncLogRecordId", keeperRecord.id);
        return;
    }

    await markOlderSamePaymentRecordsAsDuplicate(recordsForSamePayment, keeperRecord.id);

    const paymentResponse = await squareGet(`/v2/payments/${encodeURIComponent(squarePaymentId)}`);
    const payment = paymentResponse.payment;

    if (!payment || !payment.id) {
        throw new Error("Square Payments API response did not include a payment object.");
    }

    let orderResponse = null;
    let order = null;

    if (payment.order_id) {
        orderResponse = await squareGet(`/v2/orders/${encodeURIComponent(payment.order_id)}`);
        order = orderResponse.order || null;
    }

    const combinedApiResponse = { paymentResponse, orderResponse };
    const rawApiResponseText = stringifySafe(combinedApiResponse);

    const existingTransaction = await findTransactionByPaymentId(payment.id);

    const existingWebhookEventIds = existingTransaction
        ? (existingTransaction.getCellValue(TX_WEBHOOK_EVENTS) || []).map(link => link.id)
        : [];

    const transactionFields = buildTransactionFields({
        payment,
        order,
        syncLogRecordId: syncLogRecord.id,
        squareEventId,
        rawApiResponseText,
        existingWebhookEventIds
    });

    let transactionRecordId;

    if (existingTransaction) {
        await transactionsTable.updateRecordAsync(existingTransaction.id, transactionFields);
        transactionRecordId = existingTransaction.id;
    } else {
        transactionRecordId = await transactionsTable.createRecordAsync(transactionFields);
    }

    await syncLogTable.updateRecordAsync(syncLogRecord.id, {
        [SL_PROCESSING_STATUS]: { name: STATUS_PROCESSED },
        [SL_AUTOMATION_STEP]: { name: STEP_PAYMENT_RETRIEVED },
        [SL_RELATED_TRANSACTION]: [{ id: transactionRecordId }],
        [SL_RAW_API_RESPONSE]: rawApiResponseText,
        [SL_ERROR_MESSAGE]: "",
        [SL_RESOLVED]: true
    });

    output.set("result", existingTransaction ? "updated_transaction" : "created_transaction");
    output.set("syncLogRecordId", syncLogRecord.id);
    output.set("transactionRecordId", transactionRecordId);
    output.set("squarePaymentId", payment.id);
    output.set("squareOrderId", payment.order_id || "");

} catch (error) {
    output.set("result", "failed");
    output.set("error", error.message);
    throw error;
}
